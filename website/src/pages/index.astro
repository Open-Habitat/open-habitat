---
// The English front page (landing.mjs), rendered at build time inside a thin
// site shell. The page brings its own top bar, footer (with the links to the
// documentation's security model and the font licence) and browser script;
// the shell adds the head: title, robots switch, favicon, and the share tags
// from src/share.ts. The page is drawn and checked in the light theme only,
// so it is Päivä whatever the docs' theme menu says.
import '../../../design-system/styles.css';
import '../styles/brand.css';
import landing from 'virtual:landing';
import { indexable } from '../../launch.mjs';
import { shareTags, siteDescription, siteName } from '../share';

const title = 'Open Habitat · Coding-grade agents on a server for you and your team';
const description = siteDescription;
const canonical = new URL('/', Astro.site);
// Starlight writes these on the docs; the front page has its own head.
const share = [
  { property: 'og:type', content: 'website' },
  { property: 'og:site_name', content: siteName },
  { property: 'og:locale', content: 'en' },
  { property: 'og:url', content: canonical.href },
  { property: 'og:title', content: title },
  { property: 'og:description', content: description },
  { name: 'twitter:card', content: 'summary_large_image' },
  ...shareTags(Astro.site!, title, description).map((t) => t.attrs),
];
const script = landing.js.replace(/<\/script/gi, '<\\/script');
---

<!doctype html>
<html lang="en" dir="ltr" data-theme="light" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {share.map((attrs) => <meta {...attrs} />)}
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    <style is:inline set:html={landing.css}></style>
  </head>
  <body>
    <Fragment set:html={landing.html} />
    <script is:inline set:html={script}></script>
  </body>
</html>
