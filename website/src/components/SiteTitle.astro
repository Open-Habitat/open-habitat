---
// The header's site title: the design system's doorway mark
// (design-system/favicon.svg), inlined so its colours follow the theme.
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">
  <svg viewBox="0 0 48 48" width="28" height="28" aria-hidden="true">
    <rect x="2.5" y="2.5" width="43" height="43" rx="12" fill="var(--ah-accent-soft)" stroke="var(--ah-accent-line)"></rect>
    <path d="M14 36V23a10 10 0 0 1 20 0v13" fill="none" stroke="var(--ah-accent)" stroke-width="3" stroke-linecap="round"></path>
    <circle cx="24" cy="28.5" r="3.2" fill="var(--ah-accent)"></circle>
  </svg>
  <span translate="no">{siteTitle}</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ah-ink);
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }
  svg {
    flex: none;
  }
  span {
    overflow: hidden;
  }
</style>
