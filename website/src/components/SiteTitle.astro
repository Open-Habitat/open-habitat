---
// The header's site title: the Open Habitat mark, inline so its colour
// follows the theme.
import { mark } from './mark';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">
  <Fragment set:html={mark('idle', 22)} />
  <span translate="no">{siteTitle}</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ah-ink);
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }
  .site-title :global(.oh-mark) {
    color: var(--ah-accent);
  }
  span {
    overflow: hidden;
  }
</style>
