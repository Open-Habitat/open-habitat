    ],
    notTitle: 'Mitä se ei ole',
    nots: [
      ['Ei hiekkalaatikko sinun ja agenttisi välillä.', 'Agentti toimii omistajanaan, omistajan tiedostoin ja tunnuksin. Unix-tunnukset erottavat ihmiset toisistaan; ne eivät rajoita, mitä oma agenttisi voi tehdä omassa kodissasi.'],
      ['Ei klusteri.', 'Yksi Linux-palvelin, Ubuntu 24.04, amd64 tai arm64.'],
      ['Ei vielä monen harnessin.', 'Selain ohjaa Pi-agenttia.'],
      ['Ei pilvipalvelu.', 'Palvelin on sinun. Open Habitat -tiliä tai -pilveä ei ole.'],
      ['Root on root.', 'Palvelimen ylläpitäjä voi lukea jokaisen kodin, kuten millä tahansa Linux-koneella.'],
    ],
    secTitle: 'Tietoturvamalli',
    secLede: 'Kolmella osalla on erilliset valtuudet.',
    layers: [
      ['gateway', 'Tunnistaa selaimen ja liittää ihmisen Unix-käyttäjään.'],
      ['daemon', 'Ajetaan kunkin ihmisen tunnuksella, eikä se luota selaimen tai gatewayn identiteettiväitteisiin.'],
      ['root broker', 'Pieni, ja luo vain tilin ihmisen ensimmäisellä hyväksytyllä kirjautumisella.'],
    ],
    secMore:
      'Käyttäjän hallitsema koodi, kuten editori, agentin julkaisemat sivut ja jaetut linkit, tarjoillaan omalta hostiltaan erillään sovelluksesta.',
    secLink: 'Lue tietoturvamalli',
    vuln: `Löysitkö haavoittuvuuden? Käytä GitHubin <a href="${repo}/security/advisories/new">yksityistä haavoittuvuusraportointia</a>, älä julkista issueta.`,
    tryTitle: 'Kokeile',
    tryStatus:
      '<b>Tila: esijulkaisu.</b> Open Habitat on käytössä monen ihmisen asennuksissa, mutta julkista julkaisua ei vielä ole. Formaatit ja rajapinnat muuttuvat vielä julkaisujen välillä ilman siirtokoodia, ja asennus olettaa vielä ylläpitäjien apua.',
