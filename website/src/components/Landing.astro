    ],
    notTitle: 'What it is not',
    nots: [
      ['Not a sandbox between you and your agent.', 'An agent runs as its owner, with the owner’s files and credentials. Unix accounts separate people from each other; they do not limit what your own agent can do in your own home.'],
      ['Not a cluster.', 'One Linux server, Ubuntu 24.04 on amd64 or arm64.'],
      ['Not multi-harness yet.', 'Pi is the agent the browser drives.'],
      ['Not a hosted service.', 'You run the server. There is no Open Habitat account or cloud.'],
      ['Root is root.', 'The server’s administrator can read every home on it, as on any Linux machine.'],
    ],
    secTitle: 'Security model',
    secLede: 'Three components hold separate authority.',
    layers: [
      ['gateway', 'Authenticates the browser and maps the person to a Unix user.'],
      ['daemon', 'Runs as each person and trusts no identity claim from the browser or the gateway.'],
      ['root broker', 'Small, and only creates the account on a person’s first approved sign-in.'],
