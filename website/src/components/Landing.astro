---
// The site's front door in both languages: what Open Habitat is and for
// whom, how it compares, what it is not, the security model and how to try
// it. Claims rest on the repository's docs/product.md, docs/operations.md
// and the product itself; the comparison mirrors the README draft's table.
// The people and the server in the diagram are made up.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

interface Props {
  lang: 'en' | 'fi';
}

const { lang } = Astro.props;
const prefix = lang === 'fi' ? '/fi/' : '/';
const repo = 'https://github.com/Open-Habitat/open-habitat';
const pi = '<a href="https://github.com/earendil-works/pi">Pi</a>';

const t = {
  en: {
    title: 'Your team’s AI agents on one Linux server',
    description:
