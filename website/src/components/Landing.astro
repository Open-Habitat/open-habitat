    tryIt: 'How to try it',
    compareCta: 'How it compares',
    diagram: {
      laptop: 'laptop',
      phone: 'phone',
      closed: 'tab closed',
      gateway: 'GitHub sign-in → your Unix user',
      daemonAs: 'daemon as',
