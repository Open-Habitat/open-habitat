# The core runtime's headless Chromium, which renders pages for people's
# agents, starts its sandbox in user namespaces. Ubuntu 24.04 denies those to
# unconfined programs (kernel.apparmor_restrict_unprivileged_userns), and its
# own profile for Google Chrome lifts that for Chrome alone; this does the same
# for the shell in the core runtime, which only root can write: in a release
# generation's own payloads (generations staged before the payload store) or
# in the payload store the generation links to. Attachment matches the
# executable's resolved path, so both must be listed. Chromium never runs
# without its sandbox here.
abi <abi/4.0>,
include <tunables/global>

profile open-habitat-headless-shell /opt/open-habitat/{generations/*/payloads,payloads/*}/core/runtime/browsers/chromium_headless_shell-*/*/{chrome-headless-shell,headless_shell} flags=(unconfined) {
  userns,
}
