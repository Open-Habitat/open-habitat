[Unit]
Description=Open Habitat root account broker
Requires=open-habitat-broker.socket
After=open-habitat-broker.socket
# Fleetrepo owns state creation, UID pool reservation, ACL and reboot ordering.
# This neutral template does not install a preparation/repair unit.

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/open-habitat/current/open-habitat broker exec
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=no
# Account tools create /etc locks and atomically replace passwd/group/shadow;
# read-write exceptions for individual files would strand pending.json.
ReadWritePaths=/etc /var/lib/open-habitat /home /run/open-habitat
PrivateTmp=yes
PrivateDevices=yes
UMask=0077
# Account/ACL/unit operations require access to NSS, home, /etc, /run and
# systemd. Do not add blanket CapabilityBoundingSet without guest validation.
Restart=no
