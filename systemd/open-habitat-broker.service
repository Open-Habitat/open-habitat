[Unit]
Description=Open Habitat root account broker
Requires=open-habitat-storage.service open-habitat-proc.service open-habitat-broker.socket
After=open-habitat-storage.service open-habitat-proc.service open-habitat-broker.socket
# The installer owns state creation, UID pool reservation and named ACL gates.
# Enable this service as well as its socket: socket activation alone waits for
# a new login and cannot restore committed users after a reboot.
# Storage is reverified by the required read-only boot guard.

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/open-habitat/current/open-habitat broker exec
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=no
# Account tools create /etc locks and atomically replace passwd/group/shadow;
# read-write exceptions for individual files would strand pending.json.
# /opt/open-habitat: an administrator's integration app credentials are
# renamed into its integrations.json, which a file-only exception would forbid.
ReadWritePaths=/etc /var/lib/open-habitat /home /run/open-habitat /opt/open-habitat
# Removing a person (ADR 0037) deletes what their own processes left outside
# the home: files the UID owns on the host's /tmp and /var/tmp, its crontab,
# at jobs, mail spool and user journal files. The broker therefore sees the
# host's temporary directories rather than private ones; it walks them by
# descriptor and never follows a link. Absent spool directories are skipped.
ReadWritePaths=/tmp /var/tmp -/var/spool/cron -/var/mail -/var/log/journal -/run/log/journal
PrivateTmp=no
PrivateDevices=yes
UMask=0077
# Account/ACL/unit operations require access to NSS, home, /etc, /run and
# systemd. Do not add blanket CapabilityBoundingSet without guest validation.
Restart=no

[Install]
WantedBy=multi-user.target
