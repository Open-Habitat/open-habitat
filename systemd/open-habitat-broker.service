[Unit]
Description=Open Habitat root account broker
Requires=open-habitat-storage.service open-habitat-proc.service open-habitat-broker.socket
After=open-habitat-storage.service open-habitat-proc.service open-habitat-broker.socket
# The installer owns state creation, UID pool reservation and named ACL gates.
# Enable this service as well as its socket: socket activation alone waits for
# a new login and cannot restore committed users after a reboot.
# Storage is reverified by the required read-only boot guard.

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/open-habitat/current/open-habitat broker exec
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=no
# Account tools create /etc locks and atomically replace passwd/group/shadow;
# read-write exceptions for individual files would strand pending.json.
ReadWritePaths=/etc /var/lib/open-habitat /home /run/open-habitat
PrivateTmp=yes
PrivateDevices=yes
UMask=0077
# Account/ACL/unit operations require access to NSS, home, /etc, /run and
# systemd. Do not add blanket CapabilityBoundingSet without guest validation.
Restart=no

[Install]
WantedBy=multi-user.target
