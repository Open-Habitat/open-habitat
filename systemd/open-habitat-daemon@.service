[Unit]
Description=Open Habitat daemon for %i
Requires=open-habitat-proc.service open-habitat-daemon@%i.socket open-habitat-agent@%i.socket

After=open-habitat-proc.service open-habitat-daemon@%i.socket open-habitat-agent@%i.socket

[Service]
User=%i
Group=%i
ExecStart=/opt/open-habitat/current/open-habitat daemon exec --config /etc/open-habitat-daemon/daemon/user-mappings/daemon-%i.json
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=no
PrivateTmp=yes
UMask=0077
KillMode=mixed
# Pi conversations and what they start are the daemon's children. The
# default OOMPolicy=stop would end all of them when the kernel OOM-kills one
# build; an OOM kill of the daemon itself still fails and restarts the unit.
OOMPolicy=continue
Restart=on-failure
