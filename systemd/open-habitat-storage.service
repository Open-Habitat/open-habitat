[Unit]
Description=Verify Open Habitat home UUID and enforced journaled user quotas
DefaultDependencies=no
# Uncached checks can run repeatedly as dependents activate; never rate-limit them.
StartLimitIntervalSec=0
RequiresMountsFor=/home
Requires=open-habitat-proc.service systemd-tmpfiles-setup.service
After=local-fs.target open-habitat-proc.service systemd-tmpfiles-setup.service
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
# No RemainAfterExit: each new activation transaction must reobserve storage.
# No private mount namespace: verify the same /home that PID 1 will use.
ExecStart=/opt/open-habitat/current/open-habitat boot-storage-check
User=root
Group=root
UMask=0077
