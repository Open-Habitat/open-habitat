[Unit]
Description=Root-only gateway subject revocation control

[Socket]
ListenStream=/run/native-agent-host/revoke.sock
SocketUser=root
SocketGroup=root
SocketMode=0600
DirectoryMode=0750
FileDescriptorName=revoke
RemoveOnStop=yes
Service=native-agent-host-gateway.service

[Install]
WantedBy=sockets.target
