[Unit]
DefaultDependencies=no
# Uncached checks can run repeatedly as dependents activate; never rate-limit them.
StartLimitIntervalSec=0
Description=Verify committed binding and cold listener ACLs for %i
Requires=open-habitat-storage.service
After=open-habitat-storage.service
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
User=root
ExecStart=/opt/open-habitat/current/open-habitat binding-activation-check %i
RemainAfterExit=no
TimeoutStartSec=40s
UMask=0077
