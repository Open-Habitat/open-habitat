[Unit]
Description=Verify committed binding and cold listener ACLs for %i
Requires=open-habitat-storage.service
After=open-habitat-storage.service

[Service]
Type=oneshot
User=root
ExecStart=/opt/open-habitat/current/open-habitat binding-activation-check %i
RemainAfterExit=no
TimeoutStartSec=40s
UMask=0077
