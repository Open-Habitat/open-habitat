[Unit]
Requires=open-habitat-storage.service
After=open-habitat-storage.service
Description=Open Habitat restricted root broker socket
# The installer must prepare and verify root:gateway /run/open-habitat 0750
# before this socket starts, including after reboot; DirectoryMode is NOT
# an ACL/boot policy. Do not enable until that policy has landed.

[Socket]
ListenStream=/run/open-habitat/broker.sock
SocketMode=0660
SocketUser=root
SocketGroup=open-habitat-gateway
DirectoryMode=0750
FileDescriptorName=broker
RemoveOnStop=yes
Service=open-habitat-broker.service

[Install]
WantedBy=sockets.target
