[Unit]
Requires=open-habitat-storage.service open-habitat-binding@%i.service
After=open-habitat-storage.service open-habitat-binding@%i.service
Description=Open Habitat daemon socket for %i

[Socket]
ListenStream=/run/open-habitat/users/%i/daemon.sock
SocketMode=0660
SocketUser=%i
SocketGroup=open-habitat-gateway
# The broker-owned binding gate establishes and verifies named search ACLs.
DirectoryMode=0710
FileDescriptorName=daemon
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
