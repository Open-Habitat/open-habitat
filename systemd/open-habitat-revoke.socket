[Unit]
Requires=open-habitat-storage.service
After=open-habitat-storage.service
Description=Root-only gateway subject revocation control

[Socket]
ListenStream=/run/open-habitat/revoke.sock
SocketUser=root
SocketGroup=root
SocketMode=0600
DirectoryMode=0750
FileDescriptorName=revoke
RemoveOnStop=yes
Service=open-habitat-gateway.service

[Install]
WantedBy=sockets.target
