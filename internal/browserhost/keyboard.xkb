// Latin-1 and Latin Extended A/B, plus euro. Canonical X11 keysyms.
// Each spare key has an ASCII base: Chrome otherwise falls back to its
// hardware code and interprets some Latin symbols as Back/Refresh shortcuts.
// Remaining symbols use the two spare AltGr levels of ordinary US keys.
// Codes 203-207 remain reserved for pc virtual modifiers.
xkb_keymap {
 xkb_keycodes { include "evdev+aliases(qwerty)" };
 xkb_types {
  include "complete"
  // Literal symbols must remain literal when the viewer has Caps Lock on.
  // Consuming Lock prevents TigerVNC from uppercasing a candidate keysym.
  type "FOUR_LEVEL" {
   modifiers = Shift+Lock+LevelThree;
   map[None] = Level1;
   map[Lock] = Level1;
   map[Shift] = Level2;
   map[Shift+Lock] = Level2;
   map[LevelThree] = Level3;
   map[Lock+LevelThree] = Level3;
   map[Shift+LevelThree] = Level4;
   map[Shift+Lock+LevelThree] = Level4;
   level_name[Level1] = "Base";
   level_name[Level2] = "Shift";
   level_name[Level3] = "AltGr";
   level_name[Level4] = "Shift AltGr";
  };
 };
 xkb_compatibility { include "complete" };
