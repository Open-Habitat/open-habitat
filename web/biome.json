{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!storybook-static",
      "!node_modules",
      "!test-results",
      "!playwright-report"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "recommended",
        "noNoninteractiveElementInteractions": "error",
        "useKeyWithClickEvents": "error"
      },
      "correctness": {
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "ajv": "Use LazyAjv (src/app/lazyAjv.ts): a validator compiled at module load slows every page load.",
              "ajv/dist/2020.js": "Use LazyAjv (src/app/lazyAjv.ts): a validator compiled at module load slows every page load."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/app/lazyAjv.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
