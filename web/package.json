{
  "name": "open-habitat-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "demo": "node demo/start.mjs",
    "test:demo": "npm run build && npx playwright test --config playwright.demo.config.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --error-on-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'src/components/**/*.test.tsx'",
    "test:component": "vitest run src/components",
    "test:browser": "bash ../scripts/test-focused.sh --area browser",
    "test:e2e": "npx playwright test --grep-invert @a11y",
    "test:a11y": "npx playwright test --grep @a11y",
    "build": "bash ../scripts/web-build.sh",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --quiet",
    "storybook:test": "storybook build --quiet",
    "test:visual": "OH_VISUAL_CAPTURE=1 npx playwright test --grep @visual",
    "test:browser:lab": "python3 ../scripts/browser-focused.py --lab"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-php": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@reduxjs/toolkit": "2.12.0",
    "@tanstack/react-virtual": "3.14.13",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "highlight.js": "11.11.1",
    "node-diff3": "3.2.1",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-redux": "9.3.0",
    "react-router": "8.4.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "storybook": "10.6.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.23 <23"
  }
}
