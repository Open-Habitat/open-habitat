{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/integration-login.schema.json",
  "title": "A tool's login relayed through the browser: device code or pasted redirect, then folder choice",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "state"],
  "properties": {
    "schema_version": {"const": 1},
    "login_phase": {"enum": ["files", "files_discovery", "outlook", "outlook_finishing"]},
    "state": {"enum": ["none", "starting", "device_code", "open_url", "completing", "choose_folders", "completed", "failed"]},
    "attempt_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}\\.[0-9]{9}$"},
    "provider": {"$ref": "integrations.schema.json#/$defs/provider_id"},
    "address": {"$ref": "integrations.schema.json#/$defs/address"},
    "relogin": {"type": "boolean"},
    "expires_at": {"type": "string", "format": "date-time"},
    "verification_uri": {"type": "string", "maxLength": 2048, "pattern": "^https://[a-z0-9.-]+(/[A-Za-z0-9._~/-]*)?$"},
    "user_code": {"type": "string", "pattern": "^[A-Z0-9-]{4,16}$"},
    "authorization_url": {"type": "string", "maxLength": 4096, "pattern": "^https://[a-z0-9.-]+/[^\\s\\u0000-\\u001f]*$"},
    "redirect_prefix": {"type": "string", "maxLength": 64, "pattern": "^http://((127\\.0\\.0\\.1|localhost)(:[0-9]{1,5})?/?|127\\.0\\.0\\.1:[0-9]{1,5}/callback)$"},
    "folders": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["id", "name", "suggested"], "properties": {
      "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
      "name": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
      "bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
      "estimated": {"description": "bytes is the provider's own storage accounting, not a count of the files; the files are counted after the choice before anything is copied.", "const": true},
      "measuring": {"description": "The folder's size is being counted while the person chooses; a later view carries the count, or the folder stays without bytes when it could not be counted.", "const": true},
      "whole": {"description": "The whole drive, which holds every other folder listed; it is chosen alone.", "const": true},
      "suggested": {"type": "boolean", "description": "Chosen in advance. A suggestion whose size is known not to fit the home's free room is not made."}
    }}},
    "unavailable_sites": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}},
    "directory": {"$ref": "integrations.schema.json#/$defs/home_directory"},
    "free_bytes": {"description": "Room left under the home quota (or on the filesystem when no quota applies) when the folders were listed.", "type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "quota_bytes": {"description": "The home quota, when one applies.", "type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "failure": {"description": "nothing_granted: the provider's grant reaches none of the provider's services as the catalog runs them, so nothing was connected. final_sync_failed: a level change after which files would no longer sync both ways (or would sync another root) first syncs them both ways once more with the old grant; that pass failed, so the account kept its old login (and a new one was revoked). revoke_failed: a Google level change could not end the old grant before the new sign-in, so nothing changed and no sign-in started. already_connected: a new Google connection signed in to an account already connected here at another level; nothing changed, and its level is changed from the account's own Vaihda taso.", "enum": ["expired", "permission_refused", "redirect_rejected", "consent_required", "device_code_blocked", "account_mismatch", "tool_failed", "cancelled", "quota_insufficient", "quota_unavailable", "nothing_granted", "final_sync_failed", "revoke_failed", "already_connected"]},
    "progress": {"$ref": "integrations.schema.json#/$defs/sync_progress"},
    "consent_url": {"type": "string", "maxLength": 4096, "pattern": "^https://[a-z0-9.-]+/[^\\s\\u0000-\\u001f]*$"}
  },
  "allOf": [
    {"if": {"required": ["login_phase"]}, "then": {"properties": {"provider": {"const": "microsoft"}, "state": {"enum": ["device_code", "completing"]}}}},
    {"if": {"properties": {"state": {"const": "device_code"}}, "required": ["login_phase"]}, "then": {"properties": {"login_phase": {"enum": ["files", "outlook"]}}}},
    {"if": {"properties": {"state": {"const": "completing"}}, "required": ["login_phase"]}, "then": {"properties": {"login_phase": {"enum": ["files_discovery", "outlook_finishing"]}}}},
    {"if": {"properties": {"state": {"const": "none"}}}, "then": {"maxProperties": 2}},
    {"if": {"properties": {"state": {"not": {"const": "none"}}}}, "then": {"required": ["attempt_id", "provider"]}},
    {"if": {"properties": {"state": {"const": "device_code"}}}, "then": {"required": ["verification_uri", "user_code", "expires_at"]}, "else": {"not": {"anyOf": [{"required": ["verification_uri"]}, {"required": ["user_code"]}]}}},
    {"if": {"properties": {"state": {"const": "open_url"}}}, "then": {"required": ["authorization_url", "redirect_prefix", "expires_at"]}, "else": {"not": {"anyOf": [{"required": ["authorization_url"]}, {"required": ["redirect_prefix"]}]}}},
    {"if": {"properties": {"state": {"const": "choose_folders"}}}, "then": {"required": ["folders", "directory", "address"]}, "else": {"not": {"anyOf": [{"required": ["folders"]}, {"required": ["free_bytes"]}, {"required": ["quota_bytes"]}]}}},
    {"if": {"properties": {"state": {"const": "failed"}}}, "then": {"required": ["failure"]}, "else": {"not": {"anyOf": [{"required": ["failure"]}, {"required": ["consent_url"]}]}}},
    {"if": {"properties": {"failure": {"const": "consent_required"}}, "required": ["failure"]}, "then": {"required": ["consent_url"]}, "else": {"not": {"required": ["consent_url"]}}}
  ]
}
