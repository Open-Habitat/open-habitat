{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/snapshot.schema.json",
  "title": "Authenticated user snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "captured_at",
    "server_instance_id",
    "event_cursor",
    "user_observation_token",
    "write_state",
    "identity",
    "sources",
    "workspaces",
    "agents",
    "operations",
    "command_ledger"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "snapshot_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "captured_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "server_instance_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "event_cursor": {
      "$ref": "common.schema.json#/$defs/cursor"
    },
    "oldest_replay_cursor": {
      "$ref": "common.schema.json#/$defs/cursor"
    },
    "write_state": {
      "enum": [
        "enabled",
        "read_only"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "web_identity_id",
        "display_name"
      ],
      "properties": {
        "web_identity_id": {
          "type": "string",
          "pattern": "^wid_[A-Za-z0-9_-]{8,80}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sourceFact"
      }
    },
    "workspaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workspace"
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/agent"
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "operation.schema.json"
      }
    },
    "command_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epoch",
        "max_entries",
        "max_age_seconds",
        "entries"
      ],
      "properties": {
        "epoch": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "max_entries": {
          "type": "integer",
          "minimum": 1
        },
        "max_age_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "command.schema.json#/$defs/commandResult"
          },
          "maxItems": 1000
        }
      }
    },
    "user_observation_token": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "provider_account_id",
        "native_github"
      ],
      "properties": {
        "provider": {
          "enum": [
            "github",
            "google"
          ]
        },
        "provider_account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "native_github": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "description": "expired: gh still holds a github.com login whose token GitHub itself rejects, confirmed by a second check; signing in to Habitat with GitHub again replaces it. verifying: GitHub rejected the token once and the host checks again shortly. unreachable: gh could not reach GitHub or GitHub answered with a server error; the token may be fine and the host retries by itself (retry).",
              "enum": [
                "connected",
                "disconnected",
                "expired",
                "pending",
                "partial",
                "unknown",
                "unreachable",
                "verifying"
              ]
            },
            "retry": {
              "description": "The host's own retry of an outage, present only with state unreachable. attempt counts the checks that found GitHub unreachable since the outage began; while it is below attempts the host is still retrying, after that the outage is a warning and checks continue.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attempt",
                "attempts",
                "since",
                "next_at"
              ],
              "properties": {
                "attempt": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                },
                "attempts": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "since": {
                  "type": "string",
                  "format": "date-time"
                },
                "next_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "restricted_orgs": {
              "description": "Organisations whose repositories GitHub refused the person's own gh for: oauth_app, the organisation's OAuth App access restrictions (an owner approves the app); saml, SAML single sign-on the token is not authorised for (the person signs in to the organisation's SSO and reconnects). An in-memory observation of the person's daemon.",
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "owner",
                  "restriction"
                ],
                "properties": {
                  "owner": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"
                  },
                  "restriction": {
                    "enum": [
                      "oauth_app",
                      "saml"
                    ]
                  }
                }
              }
            },
            "login": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "git_protocol": {
              "const": "https"
            },
            "storage": {
              "enum": [
                "credential_store",
                "user_config_protected",
                "unavailable",
                "unknown"
              ]
            },
            "last_error_code": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{2,63}$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "observation_token",
        "presence",
        "name",
        "kind",
        "visibility",
        "mutation_state",
        "facts"
      ],
      "properties": {
        "workspace_id": {
          "$ref": "common.schema.json#/$defs/workspaceId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "kind": {
          "enum": [
            "directory",
            "git_main_worktree",
            "git_linked_worktree",
            "symlink",
            "unknown"
          ]
        },
        "publish_continuation": {
          "description": "A GitHub origin with local HEAD and no observed origin-tracking refs may be awaiting a publication push. Not a write authorization.",
          "type": "boolean"
        },
        "git_summary": {
          "$ref": "#/$defs/gitSummary"
        },
        "git_remote": {
          "description": "Observed Git remote classification for main worktrees. Unknown is never evidence of publication eligibility. No URL or credential is returned.",
          "enum": [
            "github",
            "other",
            "none",
            "unknown"
          ]
        },
        "gitea_origin": {
          "description": "For a main worktree whose origin is exactly the credential-free HTTPS address https://<base>/<owner>/<name>[.git] under the base of one of the person's tea logins: that base and owner/name, as the daemon matched them. It names a repository on a server, not an account: two accounts of one Gitea see the same clone, and which account the clone uses stays in its own Git configuration. Absent for every other origin, including SSH, which is never assumed equivalent. The address itself is never returned.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base_url",
            "full_name"
          ],
          "properties": {
            "base_url": {
              "description": "The base as integrations.schema.json's gitea_base_url spells it.",
              "type": "string",
              "minLength": 9,
              "maxLength": 2048,
              "pattern": "^https://[^\\s/?#@%\\\\]+(/[^\\s?#@%\\\\]+)*$"
            },
            "full_name": {
              "type": "string",
              "maxLength": 141,
              "pattern": "^[A-Za-z0-9_.-]{1,40}/[A-Za-z0-9_.-]{1,100}$"
            }
          }
        },
        "gitlab_origin": {
          "description": "For a main worktree whose origin is exactly the credential-free HTTPS address https://<base>/<group>/.../<project>[.git] under the base of one of the person's glab logins: that base and the project's full path, as the daemon matched them. It names a project on a server, not an account. Absent for every other origin, including SSH, which is never assumed equivalent, and for an origin gitea_origin already names. The address itself is never returned.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base_url",
            "full_name"
          ],
          "properties": {
            "base_url": {
              "description": "The base as integrations.schema.json's gitea_base_url spells it.",
              "type": "string",
              "minLength": 9,
              "maxLength": 2048,
              "pattern": "^https://[^\\s/?#@%\\\\]+(/[^\\s?#@%\\\\]+)*$"
            },
            "full_name": {
              "description": "The whole project path as integrations.schema.json's gitlab_full_name spells it.",
              "type": "string",
              "maxLength": 1024,
              "pattern": "^[A-Za-z0-9_.-]{1,255}(/[A-Za-z0-9_.-]{1,255}){1,20}$",
              "not": {
                "pattern": "(^|/)(\\.\\.?|-)(/|$)|\\.(git|atom)(/|$)"
              }
            }
          }
        },
        "visibility": {
          "enum": [
            "visible",
            "hidden"
          ]
        },
        "mutation_state": {
          "enum": [
            "allowed",
            "read_only",
            "blocked_unknown"
          ]
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/sourceFact"
          }
        },
        "observation_token": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200
        },
        "presence": {
          "enum": [
            "present",
            "absent"
          ]
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/capability"
          }
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/"
        },
        "worktrees": {
          "description": "Linked worktrees of this main checkout from Git's own registry (ADR 0025), each a place where conversations run. Taskfleet-owned worktrees are left out; their runs are observed as spinoffs.",
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/worktreePlace"
          }
        }
      }
    },
    "gitSummary": {
      "description": "Bounded native Git observation for this snapshot, not an authorization to mutate.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "dirty_count"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "maxLength": 256
        },
        "dirty_count": {
          "type": "integer",
          "minimum": 0
        },
        "github_repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
        },
        "upstream": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ahead": {
          "description": "Commits on HEAD not on the upstream, from local remote-tracking refs (as fresh as the last fetch).",
          "type": "integer",
          "minimum": 0
        },
        "behind": {
          "description": "Commits on the upstream not on HEAD.",
          "type": "integer",
          "minimum": 0
        },
        "base": {
          "$ref": "common.schema.json#/$defs/gitBase"
        }
      }
    },
    "worktreePlace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worktree_id",
        "entry",
        "name",
        "path"
      ],
      "properties": {
        "worktree_id": {
          "description": "Opaque place ID; it addresses the worktree wherever a workspace ID is accepted for conversations and Git reads.",
          "$ref": "common.schema.json#/$defs/workspaceId"
        },
        "entry": {
          "description": "The registry entry name under $GIT_DIR/worktrees.",
          "type": "string",
          "minLength": 1,
          "maxLength": 245
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "git_summary": {
          "$ref": "#/$defs/gitSummary"
        },
        "branch_moved": {
          "description": "The branch's reflog has more than its creation entry, so commits were made on it. With base.merged it means the work was merged rather than that nothing was done yet.",
          "type": "boolean"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "workspace_id",
        "observation_token",
        "presence",
        "history",
        "process",
        "control",
        "activity",
        "capabilities",
        "title",
        "queue",
        "live_tail"
      ],
      "properties": {
        "agent_id": {
          "$ref": "common.schema.json#/$defs/agentId"
        },
        "workspace_id": {
          "$ref": "common.schema.json#/$defs/workspaceId"
        },
        "worktree_id": {
          "description": "Set when the conversation's working directory is one of the workspace's worktree places.",
          "$ref": "common.schema.json#/$defs/workspaceId"
        },
        "archive": {
          "enum": [
            "active",
            "archived",
            "unknown"
          ]
        },
        "history": {
          "enum": [
            "readable",
            "missing",
            "corrupt",
            "unavailable"
          ]
        },
        "process": {
          "enum": [
            "daemon_managed_live",
            "terminal_observed_live",
            "confirmed_exited",
            "not_observed",
            "unknown",
            "stale"
          ]
        },
        "control": {
          "enum": [
            "owned",
            "read_only",
            "transfer_possible",
            "unavailable",
            "unknown"
          ]
        },
        "capabilities": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/capability"
          }
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "parent": {
          "$ref": "annotations.schema.json#/$defs/parentContext"
        },
        "queue": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision",
            "steering",
            "follow_up"
          ],
          "properties": {
            "revision": {
              "type": "string",
              "minLength": 8,
              "maxLength": 200
            },
            "steering": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 65536
              }
            },
            "follow_up": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 65536
              }
            }
          }
        },
        "history_query": {
          "type": "string",
          "pattern": "^/api/v1/agents/.+/history"
        },
        "observation_token": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200
        },
        "presence": {
          "enum": [
            "present",
            "absent"
          ]
        },
        "activity": {
          "enum": [
            "idle",
            "running",
            "settling",
            "unknown"
          ]
        },
        "pending_question": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "event.schema.json#/$defs/question"
            }
          ]
        },
        "live_tail": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "event.schema.json"
          }
        },
        "started_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "run_active": {
          "type": "boolean"
        },
        "rest": {
          "description": "The conversation rests: its browser Pi is not running, or was woken by the person's typing and has not yet been told anything, and the conversation's report card (GET /api/v1/conversations/<id>/rest) speaks for Habitat. awake says the woken Pi is ready for the message. Absent when the agent is running or has been told, and for a conversation the browser cannot start.",
          "$ref": "history.schema.json#/$defs/stop"
        },
        "spinoffs_working": {
          "description": "How many of this conversation's own Taskfleet spinoffs are working now, whether or not the conversation still waits for them. Absent when none are known to work.",
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "waiting_on": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "process_id",
              "name",
              "kind",
              "run_ids"
            ],
            "properties": {
              "process_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "kind": {
                "enum": [
                  "process",
                  "taskfleet_wait"
                ]
              },
              "run_ids": {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "spinoff": {
                "$ref": "process-event.schema.json#/$defs/spinoff"
              }
            }
          }
        }
      }
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display",
        "source",
        "generation_state",
        "replaceable"
      ],
      "properties": {
        "display": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "source": {
          "enum": [
            "new_conversation",
            "first_message_fallback",
            "generated",
            "native_session"
          ]
        },
        "generation_state": {
          "enum": [
            "not_requested",
            "pending",
            "succeeded",
            "failed",
            "unknown"
          ]
        },
        "replaceable": {
          "const": true
        },
        "last_success_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "last_error_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "manual_regeneration": {
          "$ref": "common.schema.json#/$defs/capability"
        },
        "input_policy": {
          "const": "unique_first_four_last_four_user_messages"
        }
      }
    }
  }
}
