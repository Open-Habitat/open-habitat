{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/integration-login-control.schema.json",
  "title": "Start (POST), answer (PUT) or cancel (DELETE) a relayed integration login",
  "oneOf": [
    {"type": "object", "additionalProperties": false, "required": ["action", "provider"], "properties": {
      "action": {"const": "start"},
      "provider": {"$ref": "integrations.schema.json#/$defs/provider_id"},
      "address": {"description": "Present to sign an existing account in again.", "$ref": "integrations.schema.json#/$defs/address"}
    }},
    {"type": "object", "additionalProperties": false, "required": ["action", "attempt_id", "redirect_url"], "properties": {
      "action": {"const": "redirect"},
      "attempt_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}\\.[0-9]{9}$"},
      "redirect_url": {"type": "string", "minLength": 10, "maxLength": 4096, "pattern": "^http://(127\\.0\\.0\\.1|localhost)[:/?][^\\s\\u0000-\\u001f]*$"}
    }},
    {"type": "object", "additionalProperties": false, "required": ["action", "attempt_id", "folders"], "properties": {
      "action": {"const": "folders"},
      "attempt_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}\\.[0-9]{9}$"},
      "folders": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"}}
    }},
    {"type": "object", "additionalProperties": false, "required": ["action", "attempt_id"], "properties": {
      "action": {"const": "cancel"},
      "attempt_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}\\.[0-9]{9}$"}
    }}
  ]
}
