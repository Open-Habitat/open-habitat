{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/integrations.schema.json",
  "title": "The person's integration catalog and connected accounts, read live from each tool",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "providers", "accounts", "skill"],
  "properties": {
    "schema_version": {"const": 1},
    "providers": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/provider"}},
    "accounts": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/account"}},
    "skill": {"$ref": "#/$defs/skill"}
  },
  "$defs": {
    "provider_id": {"enum": ["imap", "caldav", "carddav", "google", "microsoft", "dropbox"]},
    "service_id": {"enum": ["mail", "calendar", "contacts", "drive", "onedrive", "sharepoint", "dropbox"]},
    "address": {"type": "string", "minLength": 3, "maxLength": 254, "pattern": "^[a-z0-9._%+-]{1,64}@[a-z0-9-]{1,63}(\\.[a-z0-9-]{1,63})+$"},
    "home_directory": {"type": "string", "maxLength": 512, "pattern": "^~/cloud/[a-z0-9][a-z0-9-]*(/(?!\\.\\.?(/|$))[^/\\u0000-\\u001f]+)+$"},
    "skill": {"description": "The generated personal-data skill: current, none (no accounts), blocked (a file the host did not write occupies its path) or failed (could not be written).", "enum": ["current", "none", "blocked", "failed"]},
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "available", "login", "services"],
      "properties": {
        "id": {"$ref": "#/$defs/provider_id"},
        "available": {"description": "False when the tool is not installed or the operator has not configured the application.", "type": "boolean"},
        "unavailable_reason": {"description": "Present only when unavailable: app_credentials_required when the tools are installed and only the operator's application registration is missing, tool_unavailable otherwise.", "enum": ["app_credentials_required", "tool_unavailable"]},
        "login": {"enum": ["app_password", "pasted_redirect", "device_code"]},
        "services": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/service_id"}}
      }
    },
    "service": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "state"],
      "properties": {
        "id": {"$ref": "#/$defs/service_id"},
        "state": {"enum": ["ok", "syncing", "sync_failed", "credentials_rejected", "login_expired", "unreachable", "sync_restarting", "quota_full", "unknown"]},
        "directory": {"$ref": "#/$defs/home_directory"},
        "failure": {"description": "Why a sync_failed service stopped; the native login is retained. quota_insufficient and quota_unavailable are a transient initial-inventory admission refusal; initial_sync_incomplete is a working login whose first sync never finished (signing in again offers the initial choice).", "enum": ["quota_insufficient", "quota_unavailable", "initial_sync_incomplete"]},
        "progress": {"$ref": "#/$defs/sync_progress"}
      }
    },
    "sync_progress": {
      "description": "Transient native rclone current-pass stats; totals may change while listing and reset between Microsoft libraries. No messages or filenames.",
      "type": "object", "additionalProperties": false,
      "required": ["phase", "elapsed_seconds", "bytes", "total_bytes", "files", "total_files"],
      "properties": {
        "phase": {"enum": ["inventory", "preparing", "transferring"]},
        "service": {"enum": ["dropbox", "drive", "onedrive", "sharepoint"]},
        "elapsed_seconds": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "total_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "files": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "total_files": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "account": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "address", "services", "checked_at"],
      "properties": {
        "provider": {"$ref": "#/$defs/provider_id"},
        "address": {"$ref": "#/$defs/address"},
        "services": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/service"}},
        "checked_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
