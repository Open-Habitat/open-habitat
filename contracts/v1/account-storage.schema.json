{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/account-storage.schema.json",
  "title": "Signed-in user's native Linux quota, or the shared filesystem when the installation has no user quotas",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "usage_bytes",
        "limit_bytes"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "limits": {
          "const": "enforced"
        },
        "usage_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 1125899906842624,
          "multipleOf": 1024
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "description": "The installation sets no per-user limits (root's storage policy). Only the shared home filesystem bounds the person's files, and other people's files fill it too.",
      "required": [
        "schema_version",
        "limits",
        "filesystem"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "limits": {
          "const": "not_in_use"
        },
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capacity_bytes",
            "free_bytes"
          ],
          "properties": {
            "capacity_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "free_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    }
  ]
}
