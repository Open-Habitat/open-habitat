{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/pi-models.schema.json",
  "title": "Pi native model choices and default",
  "type": "object",
  "required": [
    "schema_version",
    "default_provider",
    "default_model",
    "models"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "default_provider": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "default_model": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "models": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "older": {
            "type": "boolean"
          },
          "outcome": {
            "enum": [
              "answered",
              "refused"
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "thinking_levels": {
            "type": "array",
            "maxItems": 7,
            "uniqueItems": true,
            "items": {
              "enum": [
                "off",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            }
          },
          "context_window": {
            "description": "The model's context window in Pi's registry.",
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000
          },
          "compaction_reserve_tokens": {
            "description": "Pi's compaction.reserveTokens for this model from the person's global Pi settings: Pi compacts automatically when the context exceeds the window minus this reserve.",
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "provider": {
            "enum": [
              "openai-codex",
              "openai",
              "anthropic",
              "deepseek",
              "claude-bridge"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "default_thinking": {
      "enum": [
        "off",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "auto_compaction": {
      "description": "Pi's global compaction.enabled setting.",
      "type": "boolean"
    },
    "catalog_status": {
      "enum": [
        "native_cached",
        "unavailable"
      ]
    }
  },
  "additionalProperties": false
}
