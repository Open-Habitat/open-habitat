{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/pi-models.schema.json",
  "title": "Pi native model choices and default",
  "type": "object",
  "required": ["schema_version", "default_model", "models"],
  "properties": {
    "schema_version": {"const": 1},
    "default_model": {"type": ["string", "null"], "maxLength": 160},
    "models": {"type": "array", "maxItems": 100, "items": {"type": "object", "required": ["id", "name"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 160}, "name": {"type": "string", "maxLength": 200}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
