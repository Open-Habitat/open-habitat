{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/pi-credentials.schema.json",
  "title": "Native Pi API-key presence and literal suffix per provider",
  "type": "object",
  "required": [
    "schema_version",
    "openai",
    "anthropic",
    "deepseek",
    "subscription"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "openai": {
      "type": "object",
      "required": [
        "present",
        "suffix"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "suffix": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_-]{4}$"
        }
      },
      "additionalProperties": false
    },
    "anthropic": {
      "type": "object",
      "required": [
        "present",
        "suffix"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "suffix": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_-]{4}$"
        }
      },
      "additionalProperties": false
    },
    "deepseek": {
      "type": "object",
      "required": [
        "present",
        "suffix"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "suffix": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_-]{4}$"
        }
      },
      "additionalProperties": false
    },
    "subscription": {
      "type": "object",
      "required": [
        "present"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
