{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/server-storage-change.schema.json",
  "title": "Administrator quota hard-limit change for one bound subject",
  "type": "object", "additionalProperties": false,
  "required": ["subject", "limit_bytes"],
  "properties": {
    "subject": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "limit_bytes": {"type": "integer", "minimum": 1048576, "maximum": 1125899906842624, "multipleOf": 1024}
  }
}
