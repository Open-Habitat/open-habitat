{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/client-load-failure.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "read", "reason", "status", "phase", "online", "read_duration_ms", "episode_duration_ms", "attempts"],
  "properties": {
    "schema_version": {"const": 1},
    "read": {"enum": ["session", "snapshot", "onboarding", "identity_pair"]},
    "reason": {"enum": ["network", "http", "invalid", "timeout", "identity_mismatch", "other"]},
    "status": {"type": "integer", "minimum": 0, "maximum": 599},
    "phase": {"enum": ["landing", "stale"]},
    "online": {"type": "boolean"},
    "read_duration_ms": {"type": "integer", "minimum": 0, "maximum": 86400000},
    "episode_duration_ms": {"type": "integer", "minimum": 0, "maximum": 86400000},
    "attempts": {"type": "integer", "minimum": 1, "maximum": 10000}
  }
}
