{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/agent-local-file-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conversation_id",
    "action"
  ],
  "properties": {
    "conversation_id": {
      "type": "string",
      "pattern": "^pi:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "action": {
      "enum": [
        "list",
        "fetch"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    }
  }
}
