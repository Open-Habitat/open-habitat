{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/agent-local-file-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "next",
    "error",
    "names",
    "attachment"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "next": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 100000
    },
    "error": {
      "enum": [
        "",
        "folder_not_reachable",
        "folder_unavailable",
        "file_not_found",
        "file_size_invalid",
        "upload_unconfirmed",
        "attachment_unavailable"
      ]
    },
    "names": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      }
    },
    "attachment": {
      "type": "string",
      "pattern": "^$|^[0-9a-f-]{36}$"
    }
  }
}
