{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/pi-startup-choice.schema.json",
  "title": "Optional per-child Pi launch intent in controller responses, until native history exists",
  "type": [
    "object",
    "null"
  ],
  "required": [
    "model"
  ],
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "thinking": {
      "enum": [
        "off",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "provider": {
      "enum": [
        "openai-codex",
        "openai"
      ]
    }
  },
  "additionalProperties": false
}
