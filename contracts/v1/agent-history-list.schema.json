{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/agent-history-list.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sessions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sessions": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id",
          "cwd",
          "state",
          "native_revision",
          "started_at"
        ],
        "properties": {
          "agent_id": {
            "type": "string",
            "pattern": "^pi:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "cwd": {
            "type": "string"
          },
          "state": {
            "enum": [
              "readable",
              "unavailable"
            ]
          },
          "native_revision": {
            "type": "string"
          },
          "started_at": {
            "type": "string"
          }
        }
      }
    }
  }
}
