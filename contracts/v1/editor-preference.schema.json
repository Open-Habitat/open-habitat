{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/editor-preference.schema.json",
  "$defs": {
    "write": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine"
      ],
      "properties": {
        "engine": {
          "enum": [
            "codemirror6",
            "vscode"
          ]
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "web_identity_id",
        "engine"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "web_identity_id": {
          "type": "string",
          "pattern": "^wid_[A-Za-z0-9_-]+$",
          "maxLength": 128
        },
        "engine": {
          "enum": [
            "codemirror6",
            "vscode"
          ]
        }
      }
    }
  },
  "$ref": "#/$defs/result"
}
