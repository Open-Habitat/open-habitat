{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://native-agent-host.invalid/contracts/v1/exchange.schema.json",
  "title": "Redacted HTTP/SSE exchange catalogue",
  "type": "array", "minItems": 1,
  "items": {
    "type": "object", "additionalProperties": false,
    "required": ["id", "request", "response"],
    "properties": {
      "id": {"type": "string", "pattern": "^EX-[0-9]{3}$"},
      "request": {"type": "object", "additionalProperties": false, "required": ["method", "path", "headers"], "properties": {"method": {"enum": ["GET", "POST"]}, "path": {"type": "string", "pattern": "^/api/v1/"}, "headers": {"type": "object", "additionalProperties": {"type": "string"}}, "body_file": {"type": "string", "pattern": "^[a-z0-9-]+\\.json$"}}},
      "response": {"type": "object", "additionalProperties": false, "required": ["status", "content_type", "body_file"], "properties": {"status": {"type": "integer", "minimum": 100, "maximum": 599}, "content_type": {"enum": ["application/json", "text/event-stream"]}, "body_file": {"type": "string", "pattern": "^[a-z0-9-]+\\.json$"}}},
      "note": {"type": "string", "maxLength": 500}
    }
  }
}
