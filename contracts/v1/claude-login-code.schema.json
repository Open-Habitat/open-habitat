{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/claude-login-code.schema.json",
  "title": "One-time native Claude login code (PUT); DELETE omits code",
  "type": "object",
  "required": ["attempt_id"],
  "properties": {
    "attempt_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}\\.[0-9]{9}$"},
    "code": {"type": "string", "pattern": "^[A-Za-z0-9_~.\\-#]{8,2048}$"}
  },
  "additionalProperties": false
}
