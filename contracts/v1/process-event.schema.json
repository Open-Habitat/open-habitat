{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/process-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "process_id",
    "process_name",
    "command_preview",
    "exit_code",
    "signal",
    "end_reason",
    "delivery",
    "run_ids"
  ],
  "properties": {
    "kind": {
      "enum": [
        "success",
        "failure",
        "crash",
        "killed",
        "log_match",
        "log_match_suppressed"
      ]
    },
    "process_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "process_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "command_preview": {
      "type": "string",
      "maxLength": 1000
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "signal": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 200
    },
    "end_reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 200
    },
    "delivery": {
      "enum": [
        "steer",
        "wake",
        "context",
        null
      ]
    },
    "run_ids": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "notification_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "spinoff": {
      "$ref": "#/$defs/spinoff"
    },
    "summary": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "$defs": {
    "spinoff": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "title",
          "status",
          "landed",
          "commit"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "done",
              "failed",
              "cancelled"
            ]
          },
          "landed": {
            "type": "boolean"
          },
          "commit": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{40}$",
            "description": "Verified integrated commit when native evidence identifies it; otherwise null. Never the pre-rebase worker OID."
          },
          "state": {
            "enum": [
              "working",
              "waiting_parent",
              "merged",
              "unmerged",
              "failed",
              "unknown"
            ]
          },
          "preserved": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
