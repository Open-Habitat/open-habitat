{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/server-storage.schema.json",
  "title": "Administrator view of bound users' native quotas and the home filesystem",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "users", "filesystem", "overcommitted"],
  "properties": {
    "schema_version": {"const": 1},
    "limits": {"enum": ["enforced", "not_in_use"], "description": "not_in_use: the installation sets no per-user limits; users is then empty and overcommitted null."},
    "users": {"type": "array", "maxItems": 1024, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "username", "administrator", "usage_bytes", "limit_bytes", "unavailable"],
      "properties": {
        "id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "username": {"type": "string"},
        "administrator": {"type": "boolean"},
        "unavailable": {"type": "boolean"},
        "usage_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "limit_bytes": {"type": "integer", "minimum": 0, "maximum": 1125899906842624, "multipleOf": 1024}
      },
      "allOf": [{
        "if": {"properties": {"unavailable": {"const": true}}},
        "then": {"properties": {"usage_bytes": {"const": 0}, "limit_bytes": {"const": 0}}},
        "else": {"properties": {"limit_bytes": {"minimum": 1048576}}}
      }]
    }},
    "filesystem": {"type": "object", "additionalProperties": false,
      "required": ["capacity_bytes", "free_bytes"],
      "properties": {
        "capacity_bytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "free_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "overcommitted": {"type": ["boolean", "null"], "description": "Null when any user quota is unavailable; not a claim of no overcommit."}
  },
  "if": {"required": ["limits"], "properties": {"limits": {"const": "not_in_use"}}},
  "then": {"properties": {"users": {"maxItems": 0}, "overcommitted": {"const": null}}}
}
