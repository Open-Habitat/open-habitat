{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/pi-conversation-create.schema.json",
  "title": "Start a native Pi conversation",
  "type": "object",
  "required": [
    "workspace_id"
  ],
  "properties": {
    "workspace_id": {
      "$ref": "common.schema.json#/$defs/workspaceId"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "thinking": {
      "enum": [
        "off",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "provider": {
      "enum": [
        "openai-codex",
        "openai",
        "anthropic",
        "deepseek",
        "claude-bridge"
      ]
    },
    "new_worktree": {
      "description": "Create a new branch from the workspace's current branch and a linked worktree for it, then start Pi there (ADR 0025). The daemon chooses the final name.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
        }
      }
    },
    "name": {
      "description": "The conversation's name from the start, such as a start-page goal's. Pi records it as the session name once it is ready; it shows until the person renames the conversation, and no automatic title replaces it. One line, at most 160 UTF-8 bytes.",
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?$"
    }
  },
  "dependentRequired": {
    "thinking": [
      "model"
    ]
  },
  "additionalProperties": false
}
