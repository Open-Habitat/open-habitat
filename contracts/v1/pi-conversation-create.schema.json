{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/pi-conversation-create.schema.json",
  "title": "Start a native Pi conversation",
  "type": "object",
  "required": [
    "workspace_id"
  ],
  "properties": {
    "workspace_id": {
      "$ref": "common.schema.json#/$defs/workspaceId"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "thinking": {
      "enum": [
        "off",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "provider": {
      "enum": [
        "openai-codex",
        "openai",
        "claude-bridge"
      ]
    }
  },
  "dependentRequired": {
    "thinking": [
      "model"
    ]
  },
  "additionalProperties": false
}
