{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/event.schema.json",
  "title": "Combined SSE event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "cursor",
    "server_instance_id",
    "sequence",
    "emitted_at",
    "kind",
    "resource",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt_[A-Za-z0-9_-]{8,80}$"
    },
    "cursor": {
      "$ref": "common.schema.json#/$defs/cursor"
    },
    "server_instance_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "emitted_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "kind": {
      "enum": [
        "snapshot.invalidated",
        "workspace.changed",
        "agent.changed",
        "history.entry",
        "assistant.delta",
        "assistant.thinking.delta",
        "tool.started",
        "tool.updated",
        "tool.finished",
        "queue.changed",
        "question.requested",
        "question.resolved",
        "turn.settled",
        "command.changed",
        "operation.changed",
        "title.changed",
        "source.warning",
        "unknown.native",
        "assistant.toolcall.delta",
        "assistant.toolcall.end",
        "bash.output",
        "pi.lifecycle",
        "pi.marker",
        "pi.retry",
        "extension.visible",
        "process.changed",
        "process.output",
        "process.notification",
        "notice.created"
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_id": {
          "$ref": "common.schema.json#/$defs/workspaceId"
        },
        "agent_id": {
          "$ref": "common.schema.json#/$defs/agentId"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^op_[A-Za-z0-9_-]{8,80}$"
        },
        "client_command_id": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "const": "user"
        }
      },
      "minProperties": 1
    },
    "native_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "snapshot.invalidated"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "enum": [
                  "source_changed",
                  "ring_truncated"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "workspace.changed"
          }
        }
      },
      "then": {
        "properties": {
          "resource": {
            "required": [
              "workspace_id"
            ]
          },
          "payload": {
            "$ref": "workspace-change.schema.json#/$defs/workspaceChange"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "agent.changed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "snapshot.schema.json#/$defs/agent"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "history.entry"
          }
        }
      },
      "then": {
        "required": [
          "native_key"
        ],
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entry_key",
              "entry_kind",
              "content"
            ],
            "properties": {
              "entry_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "entry_kind": {
                "enum": [
                  "user",
                  "assistant",
                  "tool",
                  "model_change",
                  "unknown",
                  "bash",
                  "recap"
                ]
              },
              "content": {
                "$ref": "common.schema.json#/$defs/content"
              },
              "skill": {
                "$ref": "history.schema.json#/$defs/recordedSkill"
              },
              "blocks": {
                "type": "array",
                "maxItems": 128,
                "items": {
                  "$ref": "history.schema.json#/$defs/block"
                }
              },
              "tool_call_id": {
                "type": "string",
                "maxLength": 200
              },
              "is_error": {
                "type": "boolean"
              },
              "stop_reason": {
                "type": "string",
                "maxLength": 40
              },
              "model": {
                "type": "string",
                "maxLength": 200
              },
              "context_tokens": {
                "description": "Context size Pi recorded with this assistant reply (usage.totalTokens, else the sum of its input, output and cache counters), as Pi's own context-usage reading counts it. Omitted for an aborted or failed reply and for zero usage.",
                "type": "integer",
                "minimum": 1,
                "maximum": 100000000
              },
              "truncated_blocks": {
                "type": "boolean"
              },
              "native_revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "entry_type": {
                "enum": [
                  "model_change",
                  "thinking_level_change",
                  "session_info",
                  "label",
                  "compaction",
                  "branch_summary",
                  "context_edit"
                ]
              },
              "exit_code": {
                "type": "integer"
              },
              "cancelled": {
                "type": "boolean"
              },
              "output_truncated": {
                "type": "boolean"
              },
              "exclude_from_context": {
                "type": "boolean"
              },
              "failure_cause": {
                "$ref": "history.schema.json#/$defs/bashFailure"
              },
              "notice": {
                "$ref": "notice.schema.json#/$defs/notice"
              },
              "restart": {
                "$ref": "history.schema.json#/$defs/restart"
              },
              "wait_reminder": {
                "$ref": "history.schema.json#/$defs/waitReminder"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "assistant.delta",
              "assistant.thinking.delta"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 65536
              },
              "content_index": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "tool.started",
              "tool.updated",
              "tool.finished"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool_call_id",
              "tool_name",
              "state"
            ],
            "properties": {
              "tool_call_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "tool_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "state": {
                "enum": [
                  "running",
                  "succeeded",
                  "failed",
                  "cancelled"
                ]
              },
              "content": {
                "$ref": "common.schema.json#/$defs/content"
              },
              "structured_diff": {
                "$ref": "common.schema.json#/$defs/content"
              },
              "text": {
                "type": "string",
                "maxLength": 4096
              },
              "arguments": {
                "type": "string",
                "maxLength": 4096
              },
              "content_index": {
                "type": "integer",
                "minimum": 0
              },
              "failure_cause": {
                "$ref": "history.schema.json#/$defs/bashFailure"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "queue.changed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "revision",
              "steering",
              "follow_up"
            ],
            "properties": {
              "revision": {
                "type": "string",
                "minLength": 8,
                "maxLength": 200
              },
              "steering": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 65536
                }
              },
              "follow_up": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 65536
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "question.requested"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/question"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "question.resolved"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_id",
              "outcome"
            ],
            "properties": {
              "request_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "outcome": {
                "enum": [
                  "answered",
                  "cancelled",
                  "expired"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "turn.settled"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "enum": [
                  "succeeded",
                  "failed",
                  "interrupted",
                  "unknown",
                  "settled"
                ]
              },
              "error_code": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,63}$"
              },
              "observed_at": {
                "$ref": "common.schema.json#/$defs/timestamp"
              },
              "native_key": {
                "type": "string",
                "maxLength": 128
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "command.changed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "acceptance",
              "execution"
            ],
            "properties": {
              "acceptance": {
                "enum": [
                  "accepted",
                  "rejected",
                  "uncertain",
                  "pending"
                ]
              },
              "execution": {
                "enum": [
                  "not_started",
                  "running",
                  "succeeded",
                  "failed",
                  "partial",
                  "unknown"
                ]
              },
              "error_code": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,63}$"
              },
              "client_command_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "operation.changed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "operation.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "title.changed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "snapshot.schema.json#/$defs/title"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "source.warning"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "code"
            ],
            "properties": {
              "source": {
                "enum": [
                  "filesystem",
                  "pi_history",
                  "daemon_owner",
                  "proc",
                  "tmux",
                  "git",
                  "github",
                  "taskfleet",
                  "annotation"
                ]
              },
              "code": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,63}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "unknown.native"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "native_type",
              "content"
            ],
            "properties": {
              "native_type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "content": {
                "$ref": "common.schema.json#/$defs/content"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "assistant.toolcall.delta"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "content_index",
              "text"
            ],
            "properties": {
              "content_index": {
                "type": "integer",
                "minimum": 0
              },
              "text": {
                "type": "string",
                "maxLength": 4096
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "assistant.toolcall.end"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "content_index",
              "tool_call_id",
              "tool_name"
            ],
            "properties": {
              "content_index": {
                "type": "integer",
                "minimum": 0
              },
              "tool_call_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "tool_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "text": {
                "type": "string",
                "maxLength": 4096
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "bash.output"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 4096
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "content_index": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "pi.lifecycle"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "enum": [
                  "agent_start",
                  "turn_start",
                  "turn_end",
                  "agent_end",
                  "agent_settled",
                  "message_error",
                  "message_aborted"
                ]
              },
              "will_retry": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "pi.marker"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "marker"
            ],
            "properties": {
              "marker": {
                "enum": [
                  "session_info_changed",
                  "thinking_level_changed",
                  "entry_appended",
                  "compaction_start",
                  "compaction_end"
                ]
              },
              "text": {
                "type": "string",
                "maxLength": 4096
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "pi.retry"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "signal"
            ],
            "properties": {
              "signal": {
                "enum": [
                  "auto_retry_start",
                  "auto_retry_end",
                  "summarization_retry_scheduled",
                  "summarization_retry_attempt_start",
                  "summarization_retry_finished"
                ]
              },
              "attempt": {
                "type": "integer",
                "minimum": 0
              },
              "max_attempts": {
                "type": "integer",
                "minimum": 0
              },
              "delay_ms": {
                "type": "integer",
                "minimum": 0
              },
              "success": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "extension.visible"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "key",
              "clear"
            ],
            "properties": {
              "method": {
                "enum": [
                  "notify",
                  "setStatus",
                  "setWidget"
                ]
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "text": {
                "type": "string",
                "maxLength": 4096
              },
              "clear": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "process.changed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "owner_generation"
            ],
            "properties": {
              "owner_generation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "process_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "process.output"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "owner_generation"
            ],
            "properties": {
              "owner_generation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "process_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "process.notification"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "process-event.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "notice.created"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "notice"
            ],
            "properties": {
              "notice": {
                "$ref": "notice.schema.json#/$defs/notice"
              }
            }
          },
          "resource": {
            "required": [
              "agent_id"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "question_kind",
        "prompt"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "question_kind": {
          "enum": [
            "input",
            "confirm",
            "select",
            "unknown"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "choices": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "cancellation": {
          "$ref": "common.schema.json#/$defs/capability"
        }
      }
    }
  }
}
