{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/server-conversations.schema.json",
  "title": "Administrator view of the limits on conversations working at once",
  "description": "Limits only: how many conversations a person has working is known only to that person's daemon and is not part of this view.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "default_limit", "host_default", "max_limit", "child_bytes", "memory", "people"],
  "properties": {
    "schema_version": {"const": 1},
    "default_limit": {"type": ["integer", "null"], "minimum": 1, "maximum": 128, "description": "The installation's limit; null when none is set and each daemon uses host_default."},
    "host_default": {"type": "integer", "minimum": 1, "maximum": 128},
    "max_limit": {"type": "integer", "minimum": 1, "maximum": 128},
    "child_bytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991, "description": "Measured memory of one working conversation, for the estimate."},
    "memory": {
      "description": "The host's memory now; null when it could not be read.",
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["total_bytes", "available_bytes"],
          "properties": {
            "total_bytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
            "available_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
          }}
      ]
    },
    "people": {"type": "array", "maxItems": 100, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "limit"],
      "properties": {
        "id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "limit": {"type": "integer", "minimum": 1, "maximum": 128}
      }
    }}
  }
}
