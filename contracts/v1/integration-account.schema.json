{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/integration-account.schema.json",
  "title": "Connect an app-password account or give it a new password (POST), or remove an account (DELETE)",
  "description": "For provider apple, address is the Apple ID. connect connects the chosen services with one app-specific password; add connects more services with the password already stored in that Apple ID's own accounts, never sent by the browser; password renews every account of the Apple ID; remove removes them all. mail_address is the iCloud Mail address (@icloud.com, @me.com or @mac.com), given only with mail and only when the Apple ID is not one.",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["action", "provider", "address", "server", "port", "security", "username", "password"],
      "properties": {
        "action": {"const": "connect"},
        "provider": {"const": "imap"},
        "address": {"$ref": "integrations.schema.json#/$defs/address"},
        "server": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "security": {"enum": ["tls", "starttls"]},
        "username": {"type": "string", "minLength": 1, "maxLength": 254, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "password": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "smtp_server": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$"},
        "smtp_port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "smtp_security": {"enum": ["tls", "starttls"]}
      },
      "dependentRequired": {"smtp_server": ["smtp_server", "smtp_port", "smtp_security"], "smtp_port": ["smtp_server", "smtp_port", "smtp_security"], "smtp_security": ["smtp_server", "smtp_port", "smtp_security"]}
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["action", "provider", "address", "url", "username", "password"],
      "properties": {
        "action": {"const": "connect"},
        "address": {"$ref": "integrations.schema.json#/$defs/address"},
        "username": {"type": "string", "minLength": 1, "maxLength": 254, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "password": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "provider": {"enum": ["caldav", "carddav"]},
        "url": {"type": "string", "minLength": 9, "maxLength": 2048, "pattern": "^https://[^\\s]+$"}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["action", "provider", "address", "services", "password"],
      "properties": {
        "action": {"const": "connect"},
        "provider": {"const": "apple"},
        "address": {"$ref": "integrations.schema.json#/$defs/address"},
        "services": {"$ref": "#/$defs/apple_services"},
        "mail_address": {"$ref": "integrations.schema.json#/$defs/address"},
        "password": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["action", "provider", "address", "services"],
      "properties": {
        "action": {"const": "add"},
        "provider": {"const": "apple"},
        "address": {"$ref": "integrations.schema.json#/$defs/address"},
        "services": {"$ref": "#/$defs/apple_services"},
        "mail_address": {"$ref": "integrations.schema.json#/$defs/address"}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["action", "provider", "address", "password"],
      "properties": {
        "action": {"const": "password"},
        "provider": {"enum": ["imap", "caldav", "carddav", "apple"]},
        "address": {"$ref": "integrations.schema.json#/$defs/address"},
        "password": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["action", "provider", "address", "delete_directories"],
      "properties": {
        "action": {"const": "remove"},
        "provider": {"$ref": "integrations.schema.json#/$defs/provider_id"},
        "address": {"$ref": "integrations.schema.json#/$defs/address"},
        "delete_directories": {"description": "Move the account's synced directories to the Trash; otherwise they stay as ordinary files.", "type": "boolean"}
      }
    }
  ],
  "$defs": {
    "apple_services": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["mail", "calendar", "contacts"]}}
  }
}
