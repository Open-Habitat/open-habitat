{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/spinoff-work.schema.json",
  "title": "What a parent conversation's Taskfleet workers have produced",
  "description": "Read only on request: Git against each worker's source branch and its pull request through the person's own gh. A merged worker and an ended one with nothing left on disk have no entry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "parent_id",
    "availability",
    "runs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "parent_id": {
      "type": "string",
      "pattern": "^pi:[0-9a-fA-F-]{36}$"
    },
    "availability": {
      "enum": [
        "available",
        "unavailable",
        "partial"
      ]
    },
    "runs": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "git",
          "pull_request_state"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
          },
          "git": {
            "description": "available: Git answered for the worker's worktree, or for its kept branch when the worktree is gone. unavailable: no count below is known.",
            "enum": [
              "available",
              "unavailable"
            ]
          },
          "dirty_count": {
            "description": "Changed files in the worktree; absent when only the branch was read.",
            "type": "integer",
            "minimum": 0
          },
          "ahead": {
            "description": "Commits on the worker's branch not on its source branch; absent when the source branch cannot be compared.",
            "type": "integer",
            "minimum": 0
          },
          "behind": {
            "description": "Commits on the source branch not on the worker's branch.",
            "type": "integer",
            "minimum": 0
          },
          "added": {
            "description": "Lines added from the merge base to the working tree (or the kept branch), untracked files included.",
            "type": "integer",
            "minimum": 0
          },
          "removed": {
            "type": "integer",
            "minimum": 0
          },
          "pull_request_state": {
            "description": "found: pull_request is the branch's newest. none: GitHub answered with none. unknown: gh did not answer. unsupported: the repository is not on GitHub.",
            "enum": [
              "found",
              "none",
              "unknown",
              "unsupported"
            ]
          },
          "pull_request": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "number",
              "state",
              "url",
              "checks"
            ],
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "state": {
                "enum": [
                  "open",
                  "draft",
                  "closed",
                  "merged"
                ]
              },
              "url": {
                "type": "string",
                "maxLength": 512,
                "pattern": "^https://github\\.com/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+/pull/[0-9]+$"
              },
              "checks": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "passed",
                  "failed",
                  "pending"
                ],
                "properties": {
                  "passed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "failed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "pending": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "if": {
          "properties": {
            "pull_request_state": {
              "const": "found"
            }
          }
        },
        "then": {
          "required": [
            "pull_request"
          ]
        },
        "else": {
          "not": {
            "required": [
              "pull_request"
            ]
          }
        }
      }
    }
  }
}
