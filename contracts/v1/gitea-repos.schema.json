{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/gitea-repos.schema.json",
  "title": "Repositories of the person's Gitea connections",
  "description": "GET /api/v1/integrations/gitea/repos takes no query. The mapped daemon reads each usable tea login's /user/repos with that login's own token, page by page within a time, page and result bound. Each connection is its own source with its own state: one source failing never empties another, and a failed source is never an empty success. complete is true only when a page came back empty before the bound; a short page alone does not end the list. A repository is identified by its source's connection_id and Gitea's own id, never by owner/name alone.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "sources": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "fullName": {"type": "string", "maxLength": 141, "pattern": "^[A-Za-z0-9_.-]{1,40}/[A-Za-z0-9_.-]{1,100}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["connection_id", "base_url", "user", "state", "complete", "repositories"],
      "properties": {
        "connection_id": {"$ref": "integrations.schema.json#/$defs/gitea_connection_id"},
        "base_url": {"$ref": "integrations.schema.json#/$defs/gitea_base_url"},
        "user": {"$ref": "integrations.schema.json#/$defs/gitea_user"},
        "state": {"enum": ["ok", "failed"]},
        "failure": {"enum": ["token_rejected", "insufficient_scope", "unreachable", "tls_untrusted", "redirect_refused", "forbidden_destination", "not_gitea", "native_unavailable"]},
        "complete": {"type": "boolean"},
        "repositories": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/repository"}}
      },
      "allOf": [
        {"if": {"properties": {"state": {"const": "failed"}}}, "then": {"required": ["failure"], "properties": {"complete": {"const": false}, "repositories": {"maxItems": 0}}}, "else": {"not": {"required": ["failure"]}}}
      ]
    },
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "full_name", "private", "description", "html_url", "updated_at", "size_kib", "default_branch", "empty", "archived"],
      "properties": {
        "id": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "full_name": {"$ref": "#/$defs/fullName"},
        "private": {"type": "boolean"},
        "description": {"type": "string", "maxLength": 500},
        "html_url": {"type": "string", "maxLength": 2300, "pattern": "^https://[^\\s?#@%\\\\]+$"},
        "updated_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "size_kib": {"description": "Gitea's own repository size in KiB.", "type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "default_branch": {"type": ["string", "null"], "minLength": 1, "maxLength": 255, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "empty": {"description": "Gitea says the repository has no commits; such a repository cannot be cloned as a workspace yet.", "type": "boolean"},
        "archived": {"type": "boolean"}
      }
    }
  }
}
