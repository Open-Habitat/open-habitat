{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/account-preferences.schema.json",
  "$defs": {
    "engine": {
      "enum": [
        "codemirror6",
        "vscode"
      ]
    },
    "language": {
      "description": "The interface language the person chose. system leaves it to the server default and then the browser.",
      "enum": [
        "system",
        "fi",
        "en",
        "en-US",
        "en-GB"
      ]
    },
    "quiet_sort": {
      "description": "The order of the rail's Hiljaiset section: newest first, grouped by workspace, or by title. The browser lists newest first instead of by workspace while one workspace is chosen, and keeps this value.",
      "enum": [
        "newest",
        "workspace",
        "name"
      ]
    },
    "quiet_workspace": {
      "description": "The one workspace the rail's Hiljaiset section is narrowed to, or null for every workspace. A workspace that no longer exists reads as null.",
      "oneOf": [
        {"$ref": "common.schema.json#/$defs/workspaceId"},
        {"type": "null"}
      ]
    },
    "github_workflow": {
      "description": "Whether the person allowed agents to change GitHub Actions workflows: the opt-in behind the GitHub sign-in's workflow scope. It records what the person wants, not what gh's token holds (native_github.scopes in the snapshot). The person's explicit GitHub reconnect sets it when the installed token has the workflow scope and never clears it; a write sets it directly, as Remove permission and Don't allow do with false. When it is true and the token lacks the scope, the page says the permission is missing.",
      "type": "boolean"
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "maxLength": 48
    },
    "write": {
      "description": "One change: the editor, the language, the Hiljaiset order or workspace, the GitHub workflow opt-in, or one experimental feature's switch. The daemon merges it into the stored document.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["quiet_sort"],
          "properties": {"quiet_sort": {"$ref": "#/$defs/quiet_sort"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["quiet_workspace"],
          "properties": {"quiet_workspace": {"$ref": "#/$defs/quiet_workspace"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engine"
          ],
          "properties": {
            "engine": {
              "$ref": "#/$defs/engine"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "language"
          ],
          "properties": {
            "language": {
              "$ref": "#/$defs/language"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["github_workflow"],
          "properties": {"github_workflow": {"$ref": "#/$defs/github_workflow"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "experimental"
          ],
          "properties": {
            "experimental": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 1,
              "propertyNames": {
                "$ref": "#/$defs/feature_id"
              },
              "additionalProperties": {
                "type": "boolean"
              }
            }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "web_identity_id",
        "engine",
        "language",
        "quiet_sort",
        "quiet_workspace",
        "github_workflow",
        "experimental"
      ],
      "properties": {
        "github_workflow": {"$ref": "#/$defs/github_workflow"},
        "quiet_sort": {"$ref": "#/$defs/quiet_sort"},
        "quiet_workspace": {"$ref": "#/$defs/quiet_workspace"},
        "schema_version": {
          "const": 1
        },
        "web_identity_id": {
          "type": "string",
          "pattern": "^wid_[A-Za-z0-9_-]+$",
          "maxLength": 128
        },
        "engine": {
          "$ref": "#/$defs/engine"
        },
        "language": {
          "$ref": "#/$defs/language"
        },
        "experimental": {
          "description": "The experimental features the person turned on. A feature that is off is absent.",
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "$ref": "#/$defs/feature_id"
          },
          "additionalProperties": {
            "const": true
          }
        }
      }
    }
  },
  "$ref": "#/$defs/result"
}
