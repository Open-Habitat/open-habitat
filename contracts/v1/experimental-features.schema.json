{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/experimental-features.schema.json",
  "title": "The release's experimental features and the person's saved switches",
  "$comment": "GET /agent/v1/experimental lists the Settings catalog in card order, ignoring stale saved ids. PUT changes exactly one known id through the same preference writer as the browser and returns the catalog with saved switches. Unknown ids are refused with unknown_experimental_feature (400); malformed input with invalid_arguments (400); unreadable or unwritable preferences with preferences_unavailable (503). No input selects an identity.",
  "oneOf": [
    { "$ref": "#/$defs/result" },
    { "$ref": "#/$defs/update" }
  ],
  "$defs": {
    "id": { "type": "string", "maxLength": 48, "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "text": {
      "type": "object", "additionalProperties": false,
      "required": ["fi", "en"],
      "properties": {
        "fi": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^[^\\r\\n]+$" },
        "en": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^[^\\r\\n]+$" }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "features"],
      "properties": {
        "schema_version": { "const": 1 },
        "features": {
          "type": "array", "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "title", "description", "landed", "enabled"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "title": { "$ref": "#/$defs/text" },
              "description": { "$ref": "#/$defs/text" },
              "landed": { "type": "boolean" },
              "enabled": { "type": "boolean" }
            }
          }
        }
      }
    },
    "update": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "enabled"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "enabled": { "type": "boolean" }
      }
    }
  }
}
