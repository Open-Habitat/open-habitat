{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/github-clone.schema.json",
  "title": "GitHub clone jobs",
  "description": "GET /api/v1/onboarding/github/clones lists the mapped user's daemon's clone jobs and the interrupted clones it recognises in ~/src. POST to the same path sends one action. A job lives in that daemon's memory only: leaving the page or losing the progress stream does not cancel it, and a daemon restart loses it, after which the directory is recognised as interrupted from the filesystem. Nothing is ever restarted automatically; restart and remove act only on a directory the daemon itself recognises as an interrupted clone of full_name, never on a path from the browser. A Gitea or GitLab clone, or its later workspace fetch, is refused with remote_rewritten when the person's Git configuration would rewrite its address. A GitLab clone's full_name is the project's whole path, group/subgroup/.../project; its directory is ~/src/<project>.",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/list"},
    {"$ref": "#/$defs/jobReply"},
    {"$ref": "#/$defs/dismissed"},
    {"$ref": "#/$defs/removed"}
  ],
  "$defs": {
    "fullName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_.-]{1,100}$"},
    "jobFullName": {"description": "A GitHub owner/repo, a Gitea one for a job with a gitea source, or a GitLab project path for a gitlab source.", "anyOf": [{"type": "string", "maxLength": 141, "pattern": "^[A-Za-z0-9_.-]{1,40}/[A-Za-z0-9_.-]{1,100}$"}, {"$ref": "integrations.schema.json#/$defs/gitlab_full_name"}]},
    "giteaFullName": {"type": "string", "maxLength": 141, "pattern": "^[A-Za-z0-9_.-]{1,40}/[A-Za-z0-9_.-]{1,100}$", "not": {"pattern": "^(\\.\\.?/|[^/]*/\\.\\.?$)"}},
    "giteaRepositoryId": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "jobId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "mode": {"description": "full clones the whole history; blobless is git clone --filter=blob:none, which fetches older file contents from GitHub later with the user's own credentials.", "enum": ["full", "blobless"]},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "request": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["action", "full_name", "mode"],
         "properties": {"action": {"enum": ["start", "restart"], "description": "start requires an absent destination. restart first removes the interrupted clone of full_name, then starts again."}, "full_name": {"$ref": "#/$defs/fullName"}, "mode": {"$ref": "#/$defs/mode"}}},
        {"type": "object", "additionalProperties": false, "required": ["action", "source", "connection_id", "repository_id", "mode"],
         "properties": {"action": {"enum": ["start", "restart"], "description": "Starts a clone of one repository of a Gitea connection, which the daemon looks up again by its id with that connection's own token. Only a full clone. restart first removes the interrupted clone of exactly that repository's address."}, "source": {"const": "gitea"}, "connection_id": {"$ref": "integrations.schema.json#/$defs/gitea_connection_id"}, "repository_id": {"$ref": "#/$defs/giteaRepositoryId"}, "mode": {"const": "full"}}},
        {"type": "object", "additionalProperties": false, "required": ["action", "source", "full_name"],
         "properties": {"action": {"const": "remove", "description": "Removes the interrupted Gitea clone whose own origin records this owner and name. It needs no connection, so a clone of a removed connection can still be removed."}, "source": {"const": "gitea"}, "full_name": {"$ref": "#/$defs/giteaFullName"}}},
        {"type": "object", "additionalProperties": false, "required": ["action", "source", "connection_id", "repository_id", "mode"],
         "properties": {"action": {"enum": ["start", "restart"], "description": "Starts a clone of one project of a GitLab connection, which the daemon looks up again by GitLab's numeric id with that connection's own token. Only a full clone. restart first removes the interrupted clone of exactly that project's address."}, "source": {"const": "gitlab"}, "connection_id": {"$ref": "integrations.schema.json#/$defs/gitlab_connection_id"}, "repository_id": {"$ref": "#/$defs/giteaRepositoryId"}, "mode": {"const": "full"}}},
        {"type": "object", "additionalProperties": false, "required": ["action", "source", "full_name"],
         "properties": {"action": {"const": "remove", "description": "Removes the interrupted GitLab clone whose own origin ends with this project path. It needs no connection."}, "source": {"const": "gitlab"}, "full_name": {"$ref": "integrations.schema.json#/$defs/gitlab_full_name"}}},
        {"type": "object", "additionalProperties": false, "required": ["action", "full_name"],
         "properties": {"action": {"const": "remove", "description": "Removes the interrupted clone of full_name."}, "full_name": {"$ref": "#/$defs/fullName"}}},
        {"type": "object", "additionalProperties": false, "required": ["action", "job_id"],
         "properties": {"action": {"enum": ["cancel", "dismiss"], "description": "cancel stops a running job and removes the directory it created; dismiss forgets a finished job."}, "job_id": {"$ref": "#/$defs/jobId"}}}
      ]
    },
    "job": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "full_name", "mode", "state", "started_at"],
      "properties": {
        "job_id": {"$ref": "#/$defs/jobId"},
        "full_name": {"$ref": "#/$defs/jobFullName"},
        "source": {"description": "Absent for a GitHub clone. A Gitea or GitLab clone names the connection whose token it used and the provider's repository id.", "oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["provider", "connection_id", "repository_id"], "properties": {"provider": {"const": "gitea"}, "connection_id": {"$ref": "integrations.schema.json#/$defs/gitea_connection_id"}, "repository_id": {"$ref": "#/$defs/giteaRepositoryId"}}},
          {"type": "object", "additionalProperties": false, "required": ["provider", "connection_id", "repository_id"], "properties": {"provider": {"const": "gitlab"}, "connection_id": {"$ref": "integrations.schema.json#/$defs/gitlab_connection_id"}, "repository_id": {"$ref": "#/$defs/giteaRepositoryId"}}}
        ]},
        "mode": {"$ref": "#/$defs/mode"},
        "state": {"enum": ["running", "confirmed", "failed", "cancelled"]},
        "stage": {"enum": ["reserving", "connecting", "receiving", "checkout", "verifying"]},
        "percent": {"type": "integer", "minimum": 0, "maximum": 100},
        "received_bytes": {"$ref": "#/$defs/bytes"},
        "reason": {"$ref": "github-clone-progress.schema.json#/$defs/reason"},
        "leftover": {"$ref": "github-clone-progress.schema.json#/$defs/leftover"},
        "started_at": {"$ref": "#/$defs/timestamp"},
        "finished_at": {"$ref": "#/$defs/timestamp"}
      },
      "allOf": [
        {"if": {"properties": {"state": {"const": "running"}}}, "then": {"required": ["stage"], "not": {"anyOf": [{"required": ["reason"]}, {"required": ["leftover"]}, {"required": ["finished_at"]}]}}},
        {"if": {"properties": {"state": {"enum": ["failed", "cancelled"]}}}, "then": {"required": ["reason", "leftover", "finished_at"]}},
        {"if": {"properties": {"state": {"const": "confirmed"}}}, "then": {"required": ["finished_at"], "not": {"anyOf": [{"required": ["reason"]}, {"required": ["leftover"]}]}}}
      ]
    },
    "planned": {
      "type": "object", "additionalProperties": false,
      "required": ["full_name", "state"],
      "properties": {
        "full_name": {"$ref": "#/$defs/fullName"},
        "state": {"enum": ["waiting", "refused"]},
        "reason": {"description": "The start's refusal, as the same code a person's own start gets.", "enum": ["github_auth_unavailable", "native_source_unavailable", "checkout_unavailable", "checkout_uncertain", "checkout_exists", "quota_full"]}
      },
      "allOf": [
        {"if": {"properties": {"state": {"const": "refused"}}}, "then": {"required": ["reason"]}, "else": {"not": {"required": ["reason"]}}}
      ]
    },
    "interrupted": {
      "type": "object", "additionalProperties": false,
      "required": ["full_name", "size_bytes"],
      "properties": {
        "full_name": {"$ref": "#/$defs/jobFullName"},
        "size_bytes": {"$ref": "#/$defs/bytes"},
        "source": {"description": "Absent for a GitHub clone. A Gitea or GitLab clone names the connection whose base and account its configuration records, only while exactly one usable connection matches; without one it can be removed but not restarted. A clone is GitLab's while glab holds a login for its server, and its full_name is then the project path below that login's base; otherwise it is named as a Gitea owner/name.", "oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["provider"], "properties": {"provider": {"const": "gitea"}, "connection_id": {"$ref": "integrations.schema.json#/$defs/gitea_connection_id"}}},
          {"type": "object", "additionalProperties": false, "required": ["provider"], "properties": {"provider": {"const": "gitlab"}, "connection_id": {"$ref": "integrations.schema.json#/$defs/gitlab_connection_id"}}}
        ]}
      },
      "if": {"not": {"required": ["source"]}}, "then": {"properties": {"full_name": {"$ref": "#/$defs/fullName"}}}, "else": {"if": {"properties": {"source": {"properties": {"provider": {"const": "gitlab"}}}}}, "then": {"properties": {"full_name": {"$ref": "integrations.schema.json#/$defs/gitlab_full_name"}}}, "else": {"properties": {"full_name": {"$ref": "#/$defs/giteaFullName"}}}}
    },
    "list": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "jobs", "interrupted", "interrupted_complete"],
      "properties": {
        "schema_version": {"const": 1},
        "jobs": {"description": "Newest first; at most one is running.", "type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/job"}},
        "planned": {"description": "The site's default repositories this daemon was handed at the person's first sign-in and has not started yet (ADR 0030). Each waits for ~/src's writer and becomes an ordinary job; a refused start stays with its reason and is never tried again by itself. Memory only, like the jobs.", "type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/planned"}},
        "interrupted": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/interrupted"}},
        "interrupted_complete": {"description": "false when ~/src could not be read in full; a missing entry is then not evidence of absence.", "type": "boolean"}
      }
    },
    "jobReply": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "job"],
      "properties": {"schema_version": {"const": 1}, "job": {"$ref": "#/$defs/job"}}
    },
    "dismissed": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "state", "job_id"],
      "properties": {"schema_version": {"const": 1}, "state": {"const": "dismissed"}, "job_id": {"$ref": "#/$defs/jobId"}}
    },
    "removed": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "state", "full_name"],
      "properties": {"schema_version": {"const": 1}, "state": {"enum": ["removed", "partial"], "description": "partial: some entries could not be removed; the rest stays and the person can try again."}, "full_name": {"$ref": "#/$defs/jobFullName"}}
    }
  }
}
