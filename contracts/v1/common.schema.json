{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/common.schema.json",
  "title": "Open Habitat common v1 types",
  "$defs": {
    "schemaVersion": {
      "const": 1
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "agentId": {
      "type": "string",
      "pattern": "^pi:[0-9a-fA-F-]{36}$"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^ws_[A-Za-z0-9_-]{8,64}$"
    },
    "cursor": {
      "type": "string",
      "pattern": "^ev1:[0-9a-fA-F-]{36}:[0-9]+$"
    },
    "sourceFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "state",
        "observed_at"
      ],
      "properties": {
        "source": {
          "enum": [
            "filesystem",
            "pi_history",
            "daemon_owner",
            "proc",
            "tmux",
            "git",
            "github",
            "taskfleet",
            "annotation"
          ]
        },
        "state": {
          "enum": [
            "confirmed",
            "absent",
            "unknown",
            "unavailable",
            "conflicting"
          ]
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "detail": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason_code"
      ],
      "properties": {
        "state": {
          "enum": [
            "supported",
            "unsupported",
            "unknown",
            "temporarily_unavailable"
          ]
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "requires_fresh_observation": {
          "type": "boolean"
        },
        "confirmation_challenge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "expected"
          ],
          "properties": {
            "kind": {
              "const": "exact_repository"
            },
            "expected": {
              "type": "string",
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/(?!\\.{1,2}$)[A-Za-z0-9_][A-Za-z0-9._-]{0,99}$",
              "maxLength": 201
            }
          }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_type",
        "text",
        "complete"
      ],
      "properties": {
        "media_type": {
          "enum": [
            "text/plain",
            "text/markdown",
            "text/x-diff"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 65536
        },
        "complete": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "complete": {
                "const": false
              }
            },
            "required": [
              "complete"
            ]
          },
          "then": {
            "properties": {
              "truncated": {
                "const": true
              }
            },
            "required": [
              "truncated"
            ]
          }
        }
      ]
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable",
        "correlation_id"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "retryable": {
          "type": "boolean"
        },
        "correlation_id": {
          "type": "string",
          "pattern": "^req_[A-Za-z0-9_-]{8,80}$"
        },
        "details": {
          "type": "object"
        },
        "fresh_snapshot_required": {
          "type": "boolean"
        }
      }
    },
    "gitBase": {
      "description": "Comparison of HEAD with its base branch: the source branch recorded in branch.<name>.workmux-base, else refs/remotes/origin/HEAD; for a worktree place without either (source local), its local upstream branch, else the main checkout's branch (ADR 0025). Absent when none is known or the base is the branch or its upstream. merged means HEAD is an ancestor of the base; a squash merge is not recognised.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "ref",
        "source",
        "ahead",
        "behind",
        "merged"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source": {
          "enum": [
            "recorded",
            "origin_head",
            "local"
          ]
        },
        "ahead": {
          "type": "integer",
          "minimum": 0
        },
        "behind": {
          "type": "integer",
          "minimum": 0
        },
        "merged": {
          "type": "boolean"
        }
      }
    }
  }
}
