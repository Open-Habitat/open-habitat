{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/history.schema.json",
  "title": "Native history page or bounded block chunk",
  "oneOf": [
    {
      "$ref": "#/$defs/historyPage"
    },
    {
      "$ref": "#/$defs/blockChunk"
    }
  ],
  "$defs": {
    "historyPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "agent_id",
        "native_revision",
        "entries"
      ],
      "properties": {
        "schema_version": {
          "$ref": "common.schema.json#/$defs/schemaVersion"
        },
        "agent_id": {
          "$ref": "common.schema.json#/$defs/agentId"
        },
        "native_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "entries": {
          "type": "array",
          "maxItems": 201,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entry_key",
              "kind",
              "content"
            ],
            "properties": {
              "entry_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "kind": {
                "enum": [
                  "user",
                  "assistant",
                  "tool",
                  "model_change",
                  "unknown",
                  "bash",
                  "recap"
                ]
              },
              "content": {
                "$ref": "common.schema.json#/$defs/content"
              },
              "recap": {
                "type": "object",
                "additionalProperties": false,
                "required": ["recap", "next", "through", "generated_at"],
                "properties": {
                  "recap": {"type": "string", "maxLength": 1280},
                  "next": {"type": "string", "maxLength": 640},
                  "through": {"type": "string", "minLength": 1, "maxLength": 128},
                  "generated_at": {"type": "integer", "minimum": 1, "maximum": 8640000000000000},
                  "trigger": {"type": "string", "enum": ["manual", "automatic"]}
                }
              },
              "blocks": {
                "type": "array",
                "maxItems": 128,
                "items": {
                  "$ref": "#/$defs/block"
                }
              },
              "tool_call_id": {
                "type": "string",
                "maxLength": 200
              },
              "is_error": {
                "type": "boolean"
              },
              "stop_reason": {
                "type": "string",
                "maxLength": 40
              },
              "model": {
                "type": "string",
                "maxLength": 200
              },
              "truncated_blocks": {
                "type": "boolean"
              },
              "entry_type": {
                "enum": [
                  "model_change",
                  "thinking_level_change",
                  "session_info",
                  "label",
                  "compaction",
                  "branch_summary"
                ]
              },
              "exit_code": {
                "type": "integer"
              },
              "cancelled": {
                "type": "boolean"
              },
              "output_truncated": {
                "type": "boolean"
              },
              "exclude_from_context": {
                "type": "boolean"
              }
            }
          }
        },
        "complete": {
          "type": "boolean"
        },
        "next_after": {
          "type": "string"
        },
        "older_complete": {
          "type": "boolean"
        },
        "boundary_found": {
          "type": "boolean"
        },
        "next_before": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "anyOf": [
        {
          "required": [
            "complete"
          ]
        },
        {
          "required": [
            "older_complete",
            "boundary_found"
          ]
        }
      ]
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "text",
            "thinking",
            "image",
            "toolCall",
            "unknown"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 16384
        },
        "redacted": {
          "type": "boolean"
        },
        "mime_type": {
          "type": "string",
          "maxLength": 100
        },
        "tool_call_id": {
          "type": "string",
          "maxLength": 200
        },
        "tool_name": {
          "type": "string",
          "maxLength": 200
        },
        "readable": {
          "type": "boolean"
        }
      }
    },
    "blockChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "agent_id",
        "native_revision",
        "entry_key",
        "block_index",
        "offset",
        "chunk"
      ],
      "properties": {
        "schema_version": {
          "$ref": "common.schema.json#/$defs/schemaVersion"
        },
        "agent_id": {
          "$ref": "common.schema.json#/$defs/agentId"
        },
        "native_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "entry_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "block_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "chunk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "media_type",
            "complete"
          ],
          "properties": {
            "media_type": {
              "enum": [
                "text/plain",
                "image/png",
                "image/jpeg",
                "image/gif",
                "image/webp"
              ]
            },
            "text": {
              "type": "string",
              "maxLength": 65536
            },
            "data": {
              "type": "string",
              "maxLength": 1048576,
              "pattern": "^[A-Za-z0-9+/]*={0,2}$"
            },
            "complete": {
              "type": "boolean"
            },
            "next_offset": {
              "type": "integer",
              "minimum": 0
            }
          },
          "oneOf": [
            {
              "required": [
                "text"
              ]
            },
            {
              "required": [
                "data"
              ]
            }
          ]
        }
      }
    }
  }
}
