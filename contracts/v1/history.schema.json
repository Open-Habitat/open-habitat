{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/history.schema.json",
  "title": "Native history page or bounded block chunk",
  "oneOf": [
    {
      "$ref": "#/$defs/historyPage"
    },
    {
      "$ref": "#/$defs/blockChunk"
    }
  ],
  "$defs": {
    "historyPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "agent_id",
        "native_revision",
        "entries"
      ],
      "properties": {
        "schema_version": {
          "$ref": "common.schema.json#/$defs/schemaVersion"
        },
        "agent_id": {
          "$ref": "common.schema.json#/$defs/agentId"
        },
        "cut_off": {
          "type": "boolean"
        },
        "native_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "entries": {
          "type": "array",
          "maxItems": 201,
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "complete": {
          "type": "boolean"
        },
        "next_after": {
          "type": "string"
        },
        "older_complete": {
          "type": "boolean"
        },
        "boundary_found": {
          "type": "boolean"
        },
        "next_before": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "anyOf": [
        {
          "required": [
            "complete"
          ]
        },
        {
          "required": [
            "older_complete",
            "boundary_found"
          ]
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_key",
        "kind",
        "content"
      ],
      "properties": {
        "entry_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "kind": {
          "enum": [
            "user",
            "assistant",
            "tool",
            "model_change",
            "unknown",
            "bash",
            "recap"
          ]
        },
        "content": {
          "$ref": "common.schema.json#/$defs/content"
        },
        "skill": {
          "$ref": "#/$defs/recordedSkill"
        },
        "recap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recap",
            "next",
            "through",
            "generated_at"
          ],
          "properties": {
            "recap": {
              "type": "string",
              "maxLength": 1280
            },
            "next": {
              "type": "string",
              "maxLength": 640
            },
            "through": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "generated_at": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8640000000000000
            },
            "trigger": {
              "type": "string",
              "enum": [
                "manual",
                "automatic"
              ]
            }
          }
        },
        "blocks": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "tool_call_id": {
          "type": "string",
          "maxLength": 200
        },
        "is_error": {
          "type": "boolean"
        },
        "stop_reason": {
          "type": "string",
          "maxLength": 40
        },
        "model": {
          "type": "string",
          "maxLength": 200
        },
        "context_tokens": {
          "description": "Context size Pi recorded with this assistant reply (usage.totalTokens, else the sum of its input, output and cache counters), as Pi's own context-usage reading counts it. Omitted for an aborted or failed reply and for zero usage.",
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "truncated_blocks": {
          "type": "boolean"
        },
        "entry_type": {
          "enum": [
            "model_change",
            "thinking_level_change",
            "session_info",
            "label",
            "compaction",
            "branch_summary",
            "context_edit"
          ]
        },
        "exit_code": {
          "type": "integer"
        },
        "cancelled": {
          "type": "boolean"
        },
        "output_truncated": {
          "type": "boolean"
        },
        "exclude_from_context": {
          "type": "boolean"
        },
        "timestamp": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "failure_cause": {
          "$ref": "history.schema.json#/$defs/bashFailure"
        },
        "notice": {
          "$ref": "notice.schema.json#/$defs/notice"
        },
        "restart": {
          "$ref": "#/$defs/restart"
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "text",
            "thinking",
            "image",
            "toolCall",
            "unknown",
            "process_event"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 16384
        },
        "redacted": {
          "type": "boolean"
        },
        "mime_type": {
          "type": "string",
          "maxLength": 100
        },
        "tool_call_id": {
          "type": "string",
          "maxLength": 200
        },
        "tool_name": {
          "type": "string",
          "maxLength": 200
        },
        "readable": {
          "type": "boolean"
        },
        "process_event": {
          "$ref": "process-event.schema.json"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "process_event"
              }
            }
          },
          "then": {
            "required": [
              "process_event"
            ]
          }
        }
      ]
    },
    "blockChunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "agent_id",
        "native_revision",
        "entry_key",
        "block_index",
        "offset",
        "chunk"
      ],
      "properties": {
        "schema_version": {
          "$ref": "common.schema.json#/$defs/schemaVersion"
        },
        "agent_id": {
          "$ref": "common.schema.json#/$defs/agentId"
        },
        "native_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "entry_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "block_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "chunk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "media_type",
            "complete"
          ],
          "properties": {
            "media_type": {
              "enum": [
                "text/plain",
                "image/png",
                "image/jpeg",
                "image/gif",
                "image/webp"
              ]
            },
            "text": {
              "type": "string",
              "maxLength": 65536
            },
            "data": {
              "type": "string",
              "maxLength": 1048576,
              "pattern": "^[A-Za-z0-9+/]*={0,2}$"
            },
            "complete": {
              "type": "boolean"
            },
            "next_offset": {
              "type": "integer",
              "minimum": 0
            }
          },
          "oneOf": [
            {
              "required": [
                "text"
              ]
            },
            {
              "required": [
                "data"
              ]
            }
          ]
        },
        "part": {
          "description": "Optional selector for the trailing user text in a recorded skill at native block zero. Omitted selects the instruction. The read request accepts the same part query alongside revision/offset/limit_bytes.",
          "const": "skill_arguments"
        }
      }
    },
    "bashFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "status_line"
      ],
      "properties": {
        "kind": {
          "enum": [
            "exit",
            "timeout",
            "aborted"
          ]
        },
        "amount": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "status_line": {
          "type": "string",
          "maxLength": 120
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "exit",
                  "timeout"
                ]
              }
            }
          },
          "then": {
            "required": [
              "amount"
            ]
          }
        }
      ]
    },
    "recordedSkill": {
      "description": "Recorded Pi skill invocation. content is the trailing user text; the first text block is the instruction, with generated source metadata omitted. Block reads use the same projection before pagination.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 1000,
          "minLength": 1
        },
        "description": {
          "description": "Optional description from the current skill file frontmatter, not the recorded instruction.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "stop": {
      "description": "When and why this conversation's browser Pi stopped, as the daemon saw it: idle (stopped after ten idle minutes), room (stopped to make room for another conversation), person (the person stopped, cancelled, archived or deleted), crash (Pi ended unasked) or restart (the daemon started without it, for example after an upgrade; at is then the daemon's start, the latest the stop can have been).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cause",
        "at"
      ],
      "properties": {
        "cause": {
          "enum": [
            "idle",
            "room",
            "person",
            "crash",
            "restart"
          ]
        },
        "at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "awake": {
          "type": "boolean"
        }
      }
    },
    "restart": {
      "description": "Habitat's report of a rest: when and why Pi stopped, background processes cut off with it, this conversation's Taskfleet runs that settled and the agent was not yet told about, and its runs still working. Before the wake it is the rest card; in history it is the catch-up the agent received with the person's message. Run states and summaries are Taskfleet's own report. The agent's context carries the full text; this is the person's presentation of it. In history, still_running lists only runs whose wait was cut off.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processes",
        "runs",
        "still_running"
      ],
      "properties": {
        "stopped": {
          "$ref": "#/$defs/stop"
        },
        "interrupted_turn": {
          "description": "The turn Pi was working on when it stopped never finished: the branch ends in a prompt, tool call or tool result nobody answered. Absent or false when the turn had ended. A rest with no cut-off process, no cut turn, no settled run and a fully read Taskfleet has nothing to tell: the browser shows no card and the agent gets no catch-up.",
          "type": "boolean"
        },
        "processes": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "process_id",
              "name"
            ],
            "properties": {
              "process_id": {
                "type": "string",
                "pattern": "^proc_[a-f0-9]{4}$"
              },
              "name": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        },
        "runs": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "run_id",
              "title",
              "state"
            ],
            "properties": {
              "run_id": {
                "type": "string",
                "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
              },
              "title": {
                "type": "string",
                "maxLength": 200
              },
              "state": {
                "enum": [
                  "merged",
                  "not_merged",
                  "failed",
                  "cancelled",
                  "awaiting",
                  "stalled"
                ]
              },
              "summary": {
                "description": "Taskfleet's report of the run, the worker's own words.",
                "type": "string",
                "maxLength": 2000
              },
              "ended_at": {
                "$ref": "common.schema.json#/$defs/timestamp"
              },
              "branch": {
                "description": "The branch Taskfleet kept when the work was not merged.",
                "type": "string",
                "maxLength": 300
              }
            }
          }
        },
        "still_running": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "run_id",
              "title"
            ],
            "properties": {
              "run_id": {
                "type": "string",
                "pattern": "^[0-9a-hjkmnp-tv-z]{26}$"
              },
              "title": {
                "type": "string",
                "maxLength": 200
              },
              "created_at": {
                "$ref": "common.schema.json#/$defs/timestamp"
              },
              "waited": {
                "description": "A wait the agent had started for this run was cut off when Pi stopped.",
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
