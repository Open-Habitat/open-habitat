{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/pi-credential-update.schema.json",
  "title": "Store a literal provider API key in native Pi auth",
  "type": "object",
  "required": [
    "provider",
    "key"
  ],
  "properties": {
    "provider": {
      "enum": [
        "openai",
        "anthropic",
        "deepseek"
      ]
    },
    "key": {
      "type": "string",
      "pattern": "^sk-[A-Za-z0-9_-]{20,200}$"
    }
  },
  "additionalProperties": false
}
