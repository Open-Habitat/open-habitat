{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/github-repos.schema.json",
  "title": "Authenticated pre-Pi GitHub repository page",
  "type": "object",
  "required": ["schema_version", "page", "limit", "has_more", "repositories"],
  "properties": {
    "schema_version": {"const": 1},
    "page": {"type": "integer", "minimum": 1, "maximum": 100},
    "limit": {"type": "integer", "minimum": 1, "maximum": 50},
    "has_more": {"type": "boolean"},
    "repositories": {"type": "array", "maxItems": 50, "items": {
      "type": "object", "required": ["full_name", "private", "description", "html_url", "pushed_at"],
      "properties": {
        "full_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_.-]{1,100}$"},
        "private": {"type": "boolean"},
        "description": {"type": "string", "maxLength": 500},
        "html_url": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_.-]{1,100}$"},
        "pushed_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
      }, "additionalProperties": false
    }}
  },
  "additionalProperties": false
}
