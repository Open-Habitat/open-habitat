{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-habitat.invalid/contracts/v1/github-repos.schema.json",
  "title": "Authenticated GitHub repository catalog",
  "description": "GET /api/v1/onboarding/github/repos takes no query. The mapped user's daemon reads their own /user/repos (owner, collaborator and organization member) with their own gh, at most 10 pages of 100, newest push first. complete is false when the bound was reached and more repositories may exist; an exact owner/repo is then still reachable through the repository lookup.",
  "type": "object",
  "required": ["schema_version", "complete", "repositories"],
  "properties": {
    "schema_version": {"const": 1},
    "complete": {"type": "boolean"},
    "repositories": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/repository"}}
  },
  "additionalProperties": false,
  "$defs": {
    "repository": {
      "type": "object", "required": ["full_name", "private", "description", "html_url", "pushed_at", "size_kib", "default_branch", "owner_type"],
      "properties": {
        "full_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_.-]{1,100}$"},
        "private": {"type": "boolean"},
        "description": {"type": "string", "maxLength": 500},
        "html_url": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_.-]{1,100}$"},
        "pushed_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "size_kib": {"description": "GitHub's own size estimate in KiB; not a prediction of the checkout's disk use.", "type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "default_branch": {"type": ["string", "null"], "minLength": 1, "maxLength": 255, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "owner_type": {"enum": ["User", "Organization"]}
      }, "additionalProperties": false
    }
  }
}
